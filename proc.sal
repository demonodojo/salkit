# salkit/proc.sal — ejecutar un proceso y capturar su salida (stdout + stderr mezclados).
#
# El resultado es un struct `ProcResult`: proc_exit, proc_timed_out, proc_output, proc_truncated.
# Con timeout vence -> se envía SIGKILL al proceso hijo.

import "io/io.sal"
import "io/abi.sal"
import "io/process.sal"
import "io/pipe.sal"
import "io/time.sal"
import "strbuf.sal"
import "int.sal"

struct ProcResult
    exit_code: Int
    timed_out: Int
    output: String
    truncated: Int

fn proc_exit(r: ProcResult) -> Int
    r.exit_code

fn proc_timed_out(r: ProcResult) -> Int
    r.timed_out

fn proc_output(r: ProcResult) -> String
    r.output

# 1 si la salida superó `max_bytes` y se recortó.
fn proc_truncated(r: ProcResult) -> Int
    r.truncated

fn proc_result(exit_code: Int, timed_out: Int, output: String, truncated: Int) -> ProcResult
    ProcResult(exit_code, timed_out, output, truncated)

fn proc_argv_tab(argv: Int) -> Bytes ! alloc
    n = vec_len(argv)
    tab = Bytes.new(n * 16 + 16)
    i = 0
    while i < n
        s = sk_sl_get(argv, i)
        spawn_argv_slot_ptr(tab, i, spawn_string_buf(s), s.len())
        i = i + 1
    tab

# Ejecuta `path` con la lista de argumentos `argv` (incluye argv[0]).
# `cwd` vacío = directorio actual. La salida se recorta a `max_bytes` (cabeza + cola).
fn proc_run(path: String, argv: Int, cwd: String, timeout_ms: Int, max_bytes: Int) -> ProcResult ! io, alloc
    proc_run_marker(path, argv, cwd, timeout_ms, max_bytes, "")

# Posición del primer `marker` a partir de `from` seguido de un salto de línea (el código de
# salida ya está completo), o -1.
fn proc_marker_pos(acc: String, marker: String, from: Int) -> Int
    m = sk_index_from(acc, marker, from)
    if m < 0
        return 0 - 1
    if sk_index_from(acc, "\n", m) < 0
        return 0 - 1
    m

# Como proc_run; si `marker` no está vacío, el proceso lo escribe junto a su código de salida al
# terminar ("\n" + marker + código + "\n"). Al verlo se deja de leer aunque algún nieto en segundo
# plano mantenga abierta la tubería, y el código de salida sale del marcador.
fn proc_run_marker(path: String, argv: Int, cwd: String, timeout_ms: Int, max_bytes: Int, marker: String) -> ProcResult ! io, alloc
    packed = pipe_create_go()
    if packed < 0
        return proc_result(127, 0, "pipe failed", 0)
    pp = Pipe.from_packed(packed)
    rd = pp.read_fd()
    wr = pp.write_fd()
    pid = spawn_io_argv(path, vec_len(argv), proc_argv_tab(argv), spawn_fd_closed(), wr, wr, cwd, 0 - 1)
    x = Fd.new(wr).close()
    if pid < 0
        Fd.new(rd).close()
        return proc_result(127, 0, "failed to start " + path, 0)
    chunk = Bytes.new(65536)
    deadline = uptime_ms() + timeout_ms
    hard_cap = max_bytes * 4
    if hard_cap < 1048576
        hard_cap = 1048576
    acc = ""
    total = 0
    timed_out = 0
    go = 1
    while go != 0
        left = deadline - uptime_ms()
        if left <= 0
            timed_out = 1
            go = 0
        else
            slice = left
            if slice > 100
                slice = 100
            k = Fd.new(rd).read_timeout(chunk.ptr(), 65536, slice)
            if k > 0
                before = acc.len()
                if total < hard_cap
                    acc = acc + bytes_view(chunk, 0, k).to_str()
                total = total + k
                if marker.len() > 0
                    from = before - marker.len()
                    if from < 0
                        from = 0
                    if proc_marker_pos(acc, marker, from) >= 0
                        go = 0
            elsif k == 0
                go = 0
            elsif k != 0 - 11
                go = 0
    if timed_out != 0
        x = kill_pid(pid, 9)
    status = wait_pid(pid)
    x = Fd.new(rd).close()
    code = Wait.from_raw(status).exit_code()
    if marker.len() > 0
        mp = proc_marker_pos(acc, marker, 0)
        if mp >= 0
            nl = sk_index_from(acc, "\n", mp)
            code = sk_parse_int(acc.slice(mp + marker.len(), nl))
            cut = mp
            if cut > 0
                if acc.char(cut - 1) == 10
                    cut = cut - 1
            acc = acc.slice(0, cut)
    if timed_out != 0
        code = 124
    trunc = 0
    if acc.len() > max_bytes
        trunc = 1
        acc = sk_truncate_middle(acc, max_bytes)
    proc_result(code, timed_out, acc, trunc)

# Ejecuta `shell -c cmd` (shell = "/bin/sh" en Linux, "/bin/sosh" en soso).
# Con un shell POSIX la orden termina cuando termina el shell, aunque deje procesos en segundo plano
# con la tubería abierta (`servidor &`): un `trap ... EXIT` escribe el código de salida y se deja de leer.
# `sosh` no se envuelve: no garantiza `trap`.
fn proc_sh(shell: String, cmd: String, cwd: String, timeout_ms: Int, max_bytes: Int) -> ProcResult ! io, alloc
    argv = vec_new()
    x = vec_push(argv, shell.to_int())
    x = vec_push(argv, "-c".to_int())
    marker = ""
    script = cmd.slice(0, cmd.len())
    if sk_ends_with(shell, "sosh") == 0
        marker = "@@salkit-exit:" + uptime_ms().to_str() + ":"
        bs = String.from_char(92)
        script = "trap 'printf " + String.from_char(34) + bs + "n%s%s" + bs + "n" + String.from_char(34) + " " + marker + " " + String.from_char(34) + "$?" + String.from_char(34) + "' EXIT" + String.from_char(10) + cmd
    x = vec_push(argv, script.to_int())
    proc_run_marker(shell, argv, cwd, timeout_ms, max_bytes, marker)
