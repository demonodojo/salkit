# salkit/json.sal — parser JSON a un documento tipado, constructor y volcado.
#
# Un documento es un `JsonDoc`: posee sus nodos (listas paralelas) y sus cadenas, y las
# libera al salir de ámbito. Cada nodo es un índice Int (-1 = ausente).
# Tipos de nodo: 0 null, 1 false, 2 true, 3 string, 4 número, 5 array, 6 objeto.
# Los números conservan el texto original (json_str) y su parte entera (json_int).
#
# Lectores: `json_str` / `json_key` devuelven un préstamo del documento (`&String`);
# `json_error` presta el error. Las funciones del parser toman el documento `&mut`.

import "int.sal"
import "strbuf.sal"

# ---------------------------------------------------------------- documento

struct JsonDoc
    kinds: List[Int]
    strs: List[String]
    nums: List[Int]
    first: List[Int]
    next: List[Int]
    last: List[Int]
    keys: List[String]
    root: Int
    pos: Int
    err: String
    empty: String

fn json_new_doc() -> JsonDoc ! alloc
    JsonDoc(List.new[Int](), List.new[String](), List.new[Int](), List.new[Int](), List.new[Int](), List.new[Int](), List.new[String](), 0 - 1, 0, d"", d"")

fn jn_new(d: &mut JsonDoc, kind: Int) -> Int ! alloc
    id = d.kinds.len()
    d.kinds.push(kind)
    d.strs.push(d"")
    d.nums.push(0)
    d.first.push(0 - 1)
    d.next.push(0 - 1)
    d.last.push(0 - 1)
    d.keys.push(d"")
    id

fn jn_add(d: &mut JsonDoc, parent: Int, child: Int) -> Int ! alloc
    last = d.last.get(parent)
    if last < 0
        d.first.set(parent, child)
    else
        d.next.set(last, child)
    d.last.set(parent, child)
    cnt = d.nums.get(parent) + 1
    d.nums.set(parent, cnt)
    child

# ---------------------------------------------------------------- acceso

fn json_root(d: &JsonDoc) -> Int
    d.root

fn json_ok(d: &JsonDoc) -> Int
    if d.err.len() != 0
        return 0
    if d.root < 0
        return 0
    1

fn json_error(d: &JsonDoc) -> &String
    &d.err

fn json_kind(d: &JsonDoc, n: Int) -> Int
    if n < 0
        0 - 1
    else
        d.kinds.get(n)

fn json_is_null(d: &JsonDoc, n: Int) -> Int
    if json_kind(d, n) == 0
        1
    else
        0

fn json_is_string(d: &JsonDoc, n: Int) -> Int
    if json_kind(d, n) == 3
        1
    else
        0

fn json_is_number(d: &JsonDoc, n: Int) -> Int
    if json_kind(d, n) == 4
        1
    else
        0

fn json_is_array(d: &JsonDoc, n: Int) -> Int
    if json_kind(d, n) == 5
        1
    else
        0

fn json_is_object(d: &JsonDoc, n: Int) -> Int
    if json_kind(d, n) == 6
        1
    else
        0

# Texto de una string (ya sin escapes) o texto original de un número; "" en otro caso.
fn json_str(d: &JsonDoc, n: Int) -> &String
    k = json_kind(d, n)
    if k == 3
        return d.strs.get(n)
    if k == 4
        return d.strs.get(n)
    return &d.empty

# Parte entera de un número (0 si el nodo no es un número). true -> 1.
fn json_int(d: &JsonDoc, n: Int) -> Int
    k = json_kind(d, n)
    if k == 4
        return d.nums.get(n)
    if k == 2
        return 1
    0

fn json_bool(d: &JsonDoc, n: Int) -> Int
    k = json_kind(d, n)
    if k == 2
        return 1
    if k == 4
        if d.nums.get(n) != 0
            return 1
    0

# Número de hijos de un array u objeto (0 en otro caso).
fn json_len(d: &JsonDoc, n: Int) -> Int
    k = json_kind(d, n)
    if k == 5
        return d.nums.get(n)
    if k == 6
        return d.nums.get(n)
    0

fn json_first(d: &JsonDoc, n: Int) -> Int
    if n < 0
        0 - 1
    else
        d.first.get(n)

fn json_next(d: &JsonDoc, n: Int) -> Int
    if n < 0
        0 - 1
    else
        d.next.get(n)

# Clave de un miembro de objeto ("" si el nodo no es miembro).
fn json_key(d: &JsonDoc, n: Int) -> &String
    if n < 0
        &d.empty
    else
        d.keys.get(n)

# Elemento i de un array (o miembro i de un objeto); -1 si no existe.
fn json_at(d: &JsonDoc, n: Int, i: Int) -> Int
    if i < 0
        return 0 - 1
    c = json_first(d, n)
    j = 0
    while c >= 0
        if j == i
            return c
        j = j + 1
        c = json_next(d, c)
    0 - 1

# Miembro `key` de un objeto; -1 si no existe.
fn json_get(d: &JsonDoc, n: Int, key: &String) -> Int
    if json_kind(d, n) != 6
        return 0 - 1
    c = json_first(d, n)
    while c >= 0
        if d.keys.get(c).eq(key) != 0
            return c
        c = json_next(d, c)
    0 - 1

fn json_has(d: &JsonDoc, n: Int, key: &String) -> Int
    if json_get(d, n, key) >= 0
        1
    else
        0

# Ruta con puntos: "choices.0.message.content" (los segmentos numéricos indexan arrays).
fn json_path(d: &JsonDoc, n: Int, path: &String) -> Int ! alloc
    segs = sk_split_char(path, 46)
    cur = n
    i = 0
    cnt = sk_sl_len(&segs)
    while i < cnt
        if cur < 0
            return 0 - 1
        if json_kind(d, cur) == 5
            if sk_is_int(sk_sl_get(&segs, i)) != 0
                cur = json_at(d, cur, sk_parse_int(sk_sl_get(&segs, i)))
            else
                cur = 0 - 1
        else
            cur = json_get(d, cur, sk_sl_get(&segs, i))
        i = i + 1
    cur

# Copia del texto de un miembro (el documento conserva la suya).
fn json_get_str(d: &JsonDoc, n: Int, key: &String) -> String ! alloc
    json_str(d, json_get(d, n, key)).clone()

fn json_get_int(d: &JsonDoc, n: Int, key: &String) -> Int
    json_int(d, json_get(d, n, key))

# ---------------------------------------------------------------- escritura

fn jp_hexc(v: Int) -> Int
    if v < 10
        48 + v
    else
        87 + v

# 1 si el byte hay que escapar dentro de una string JSON.
fn jp_needs_esc(c: Int) -> Int
    if c < 32
        return 1
    if c == 34
        return 1
    if c == 92
        return 1
    0

fn jp_esc_seq(c: Int) -> String ! alloc
    bs = String.from_char(92)
    if c == 34
        return bs + String.from_char(34)
    if c == 92
        return bs + bs
    if c == 10
        return bs + "n"
    if c == 13
        return bs + "r"
    if c == 9
        return bs + "t"
    if c == 8
        return bs + "b"
    if c == 12
        return bs + "f"
    bs + "u00" + String.from_char(jp_hexc(c / 16)) + String.from_char(jp_hexc(c % 16))

# Contenido de una string JSON (sin comillas). Los bytes >= 128 pasan tal cual (UTF-8).
fn json_escape(s: &String) -> String ! alloc
    n = s.len()
    out = ""
    start = 0
    i = 0
    while i < n
        c = s.char(i)
        if jp_needs_esc(c) != 0
            out = out + s.slice(start, i) + jp_esc_seq(c)
            start = i + 1
        i = i + 1
    if start == 0
        return s.slice(0, n)
    out = out + s.slice(start, n)
    out

# String JSON completa, con comillas.
fn json_quote(s: &String) -> String ! alloc
    q = String.from_char(34)
    q + json_escape(s) + q

fn jb_obj(inner: &String) -> String ! alloc
    String.from_char(123) + inner + String.from_char(125)

fn jb_arr(inner: &String) -> String ! alloc
    String.from_char(91) + inner + String.from_char(93)

# "clave":valor_crudo
fn jb_kv(key: &String, raw: &String) -> String ! alloc
    json_quote(key) + ":" + raw

# Lista de fragmentos JSON separados por comas.
fn jb_join(sl: &List[String]) -> String ! alloc
    sk_join(sl, &",")

fn json_dump(d: &JsonDoc, n: Int) -> String ! alloc
    k = json_kind(d, n)
    if k == 1
        return "false"
    if k == 2
        return "true"
    if k == 3
        return json_quote(json_str(d, n))
    if k == 4
        raw = json_str(d, n)
        return raw.slice(0, raw.len())
    if k == 5
        out = String.from_char(91)
        c = json_first(d, n)
        i = 0
        while c >= 0
            if i > 0
                out = out + ","
            out = out + json_dump(d, c)
            i = i + 1
            c = json_next(d, c)
        out = out + String.from_char(93)
        return out
    if k == 6
        out = String.from_char(123)
        c = json_first(d, n)
        i = 0
        while c >= 0
            if i > 0
                out = out + ","
            out = out + json_quote(json_key(d, c)) + ":" + json_dump(d, c)
            i = i + 1
            c = json_next(d, c)
        out = out + String.from_char(125)
        return out
    "null"

# ---------------------------------------------------------------- parser

fn jp_fail(d: &mut JsonDoc, msg: &String) -> Int ! alloc
    if d.err.len() == 0
        text = msg + " at offset " + d.pos.to_str()
        d.err = text
    0 - 1

fn jp_ws(t: &String, p: Int) -> Int
    n = t.len()
    i = p
    while i < n
        c = t.char(i)
        step = match c
            32 => 1
            10 => 1
            13 => 1
            9 => 1
            _ => 0
        if step == 0
            return i
        i = i + step
    i

fn jp_utf8(cp: Int) -> String ! alloc
    if cp < 128
        return String.from_char(cp)
    if cp < 2048
        return String.from_char(192 + (cp >> 6)) + String.from_char(128 + (cp & 63))
    if cp < 65536
        return String.from_char(224 + (cp >> 12)) + String.from_char(128 + ((cp >> 6) & 63)) + String.from_char(128 + (cp & 63))
    String.from_char(240 + (cp >> 18)) + String.from_char(128 + ((cp >> 12) & 63)) + String.from_char(128 + ((cp >> 6) & 63)) + String.from_char(128 + (cp & 63))

# Cuatro dígitos hex desde t[p]; -1 si no son válidos.
fn jp_hex4(t: &String, p: Int) -> Int
    if p + 4 > t.len()
        return 0 - 1
    v = 0
    i = 0
    while i < 4
        h = sk_hex_digit(t.char(p + i))
        if h < 0
            return 0 - 1
        v = v * 16 + h
        i = i + 1
    v

# Lee una string; la posición (d.pos) apunta a la comilla de apertura.
# Deja el error en d.err si falla.
fn jp_string(d: &mut JsonDoc, t: &String) -> String ! alloc
    n = t.len()
    i = d.pos + 1
    start = i
    out = ""
    esc = 0
    while i < n
        c = t.char(i)
        if c == 34
            d.pos = i + 1
            if esc == 0
                return t.slice(start, i)
            return out + t.slice(start, i)
        if c == 92
            esc = 1
            out = out + t.slice(start, i)
            if i + 1 >= n
                d.pos = i
                x = jp_fail(d, &"unterminated escape")
                return ""
            e = t.char(i + 1)
            i = i + 2
            if e == 117
                cp = jp_hex4(t, i)
                if cp < 0
                    d.pos = i
                    x = jp_fail(d, &"bad unicode escape")
                    return ""
                i = i + 4
                if cp >= 55296
                    if cp <= 56319
                        if i + 1 < n
                            if t.char(i) == 92
                                if t.char(i + 1) == 117
                                    lo = jp_hex4(t, i + 2)
                                    if lo >= 56320
                                        if lo <= 57343
                                            cp = 65536 + ((cp - 55296) << 10) + (lo - 56320)
                                            i = i + 6
                out = out + jp_utf8(cp)
            else
                ch = match e
                    110 => 10
                    116 => 9
                    114 => 13
                    98 => 8
                    102 => 12
                    34 => 34
                    92 => 92
                    47 => 47
                    _ => 0 - 1
                if ch < 0
                    d.pos = i
                    x = jp_fail(d, &"bad escape")
                    return ""
                out = out + String.from_char(ch)
            start = i
        else
            i = i + 1
    d.pos = n
    x = jp_fail(d, &"unterminated string")
    ""

# Posición tras la racha de dígitos que empieza en p.
fn jp_digits(t: &String, p: Int) -> Int
    n = t.len()
    i = p
    while i < n
        c = t.char(i)
        if c < 48
            return i
        if c > 57
            return i
        i = i + 1
    i

fn jp_number(d: &mut JsonDoc, t: &String) -> Int ! alloc
    n = t.len()
    start = d.pos
    i = start
    if i < n
        if t.char(i) == 45
            i = i + 1
    ds = i
    intend = jp_digits(t, i)
    if intend == ds
        return jp_fail(d, &"invalid number")
    i = intend
    if i < n
        if t.char(i) == 46
            i = jp_digits(t, i + 1)
    i = jp_exp(t, i)
    jp_number_node(d, t, start, ds, intend, i)

# Salta un exponente opcional (e/E, signo, dígitos) y devuelve la posición final.
fn jp_exp(t: &String, p: Int) -> Int
    n = t.len()
    i = p
    if i >= n
        return i
    c = t.char(i)
    if c != 101
        if c != 69
            return i
    i = i + 1
    if i < n
        c = t.char(i)
        sign = match c
            43 => 1
            45 => 1
            _ => 0
        if sign != 0
            i = i + 1
    jp_digits(t, i)

fn jp_number_node(d: &mut JsonDoc, t: &String, start: Int, ds: Int, intend: Int, endp: Int) -> Int ! alloc
    node = jn_new(d, 4)
    raw = t.slice(start, endp)
    d.strs.set(node, raw)
    frac = t.slice(ds, intend)
    v = sk_parse_int(&frac)
    if ds > start
        v = 0 - v
    d.nums.set(node, v)
    d.pos = endp
    node

fn jp_literal(d: &mut JsonDoc, t: &String, word: &String, kind: Int) -> Int ! alloc
    p = d.pos
    wl = word.len()
    if p + wl > t.len()
        return jp_fail(d, &"unexpected token")
    i = 0
    while i < wl
        if t.char(p + i) != word.char(i)
            return jp_fail(d, &"unexpected token")
        i = i + 1
    d.pos = p + wl
    jn_new(d, kind)

fn jp_value(d: &mut JsonDoc, t: &String, depth: Int) -> Int ! alloc
    if depth > 200
        return jp_fail(d, &"nesting too deep")
    i = jp_ws(t, d.pos)
    d.pos = i
    if i >= t.len()
        return jp_fail(d, &"unexpected end of input")
    c = t.char(i)
    if c == 123
        return jp_object(d, t, depth)
    if c == 91
        return jp_array(d, t, depth)
    if c == 34
        s = jp_string(d, t)
        if d.err.len() != 0
            return 0 - 1
        node = jn_new(d, 3)
        d.strs.set(node, s)
        return node
    if c == 116
        return jp_literal(d, t, &"true", 2)
    if c == 102
        return jp_literal(d, t, &"false", 1)
    if c == 110
        return jp_literal(d, t, &"null", 0)
    if c == 45
        return jp_number(d, t)
    if c >= 48
        if c <= 57
            return jp_number(d, t)
    jp_fail(d, &"unexpected character")

fn jp_array(d: &mut JsonDoc, t: &String, depth: Int) -> Int ! alloc
    node = jn_new(d, 5)
    i = jp_ws(t, d.pos + 1)
    d.pos = i
    if i < t.len()
        if t.char(i) == 93
            d.pos = i + 1
            return node
    done = 0
    while done == 0
        child = jp_value(d, t, depth + 1)
        if child < 0
            return 0 - 1
        x = jn_add(d, node, child)
        i = jp_ws(t, d.pos)
        d.pos = i
        if i >= t.len()
            return jp_fail(d, &"unterminated array")
        c = t.char(i)
        kind = match c
            44 => 1
            93 => 2
            _ => 0
        if kind == 0
            return jp_fail(d, &"expected , or ]")
        d.pos = i + 1
        if kind == 2
            done = 1

    node

fn jp_object(d: &mut JsonDoc, t: &String, depth: Int) -> Int ! alloc
    node = jn_new(d, 6)
    i = jp_ws(t, d.pos + 1)
    d.pos = i
    if i < t.len()
        if t.char(i) == 125
            d.pos = i + 1
            return node
    done = 0
    while done == 0
        i = jp_ws(t, d.pos)
        d.pos = i
        if i >= t.len()
            return jp_fail(d, &"unterminated object")
        if t.char(i) != 34
            return jp_fail(d, &"expected string key")
        key = jp_string(d, t)
        if d.err.len() != 0
            return 0 - 1
        i = jp_ws(t, d.pos)
        d.pos = i
        if i >= t.len()
            return jp_fail(d, &"unterminated object")
        if t.char(i) != 58
            return jp_fail(d, &"expected :")
        d.pos = i + 1
        child = jp_value(d, t, depth + 1)
        if child < 0
            return 0 - 1
        d.keys.set(child, key)
        x = jn_add(d, node, child)
        i = jp_ws(t, d.pos)
        d.pos = i
        if i >= t.len()
            return jp_fail(d, &"unterminated object")
        c = t.char(i)
        kind = match c
            44 => 1
            125 => 2
            _ => 0
        if kind == 0
            return jp_fail(d, &"expected , or }")
        d.pos = i + 1
        if kind == 2
            done = 1

    node

# Parsea `text` y devuelve el documento (mira json_ok antes de usarlo).
fn json_parse(text: &String) -> JsonDoc ! alloc
    d = json_new_doc()
    root = jp_value(&mut d, text, 0)
    d.root = root
    d
