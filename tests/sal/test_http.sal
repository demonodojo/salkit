import "io/process.sal"
import "io/time.sal"
import "../../http.sal"
import "../../json.sal"
import "support/assert.sal"

fn main() -> Int ! io, alloc
    f = 0
    port = 18931
    local = "127.0.0.1"
    none = ""
    pid = spawn_io_5(&"python3", &"tests/sal/support/mock_server.py", &"18931", &none, &none, SPAWN_FD_CLOSED, SPAWN_FD_CLOSED, SPAWN_FD_CLOSED, 0 - 1)
    sleep_ms(700)

    r = http_get(&local, port, &"/", &none, 5000)
    f = f + ck_int(http_status(&r), 200, 1)
    f = f + ck_str(http_body(&r), &"ok", 2)
    f = f + ck_str(&http_header(&r, &"x-custom"), &"Val", 3)
    f = f + ck_str(&http_header(&r, &"X-CUSTOM"), &"Val", 4)
    f = f + ck_int(http_is_ok(&r), 1, 5)

    body_json = "{\"a\":\"b\"}"
    r2 = http_post_json(&local, port, &"/echo", &"tok123", &body_json, 5000)
    f = f + ck_int(http_status(&r2), 200, 6)
    d = json_parse(http_body(&r2))
    root = json_root(&d)
    f = f + ck_str(&json_get_str(&d, root, &"auth"), &"Bearer tok123", 7)
    f = f + ck_str(&json_get_str(&d, root, &"body"), &body_json, 8)
    f = f + ck_int(json_get_int(&d, root, &"len"), 9, 9)
    f = f + ck_str(&json_get_str(&d, root, &"ctype"), &"application/json", 10)

    r3 = http_post_json(&local, port, &"/busy", &none, &"{}", 5000)
    f = f + ck_int(http_status(&r3), 429, 11)
    f = f + ck_int(http_is_ok(&r3), 0, 12)

    r4 = http_get(&local, port, &"/chunked", &none, 5000)
    f = f + ck_str(http_body(&r4), &"hello chunked world", 13)

    r5 = http_get(&local, port, &"/big", &none, 10000)
    f = f + ck_int(http_body(&r5).len(), 1000000, 14)

    r6 = http_get(&local, port, &"/nolen", &none, 5000)
    f = f + ck_str(http_body(&r6), &"until-close", 15)

    r7 = http_get(&local, port, &"/notfound", &none, 5000)
    f = f + ck_int(http_status(&r7), 404, 16)
    errdoc = json_parse(http_body(&r7))
    f = f + ck_str(&json_get_str(&errdoc, 0, &"error"), &"nope", 17)

    r8 = http_get(&local, port, &"/slow", &none, 500)
    f = f + ck_int(http_status(&r8), 0, 18)
    f = f + ck_int(http_error(&r8).len() > 0, 1, 19)

    r9 = http_get(&local, 18932, &"/", &none, 2000)
    f = f + ck_int(http_status(&r9), 0, 20)
    f = f + ck_int(http_error(&r9).len() > 0, 1, 21)

    # streaming: líneas repartidas entre chunks
    h = hs_open(&local, port, &"/sse", &"tk", &"{}", 5000)
    f = f + ck_int(hs_status(&h), 200, 30)
    f = f + ck_str(&hs_next_line(&mut h), &"data: one", 31)
    f = f + ck_str(&hs_next_line(&mut h), &"", 32)
    f = f + ck_str(&hs_next_line(&mut h), &"data: two", 33)
    f = f + ck_str(&hs_next_line(&mut h), &"", 34)
    f = f + ck_str(&hs_next_line(&mut h), &"data: [DONE]", 35)
    f = f + ck_str(&hs_next_line(&mut h), &"", 36)
    eof = String.from_char(4)
    f = f + ck_str(&hs_next_line(&mut h), &eof, 37)
    x = hs_close(&mut h)
    h2 = hs_open(&local, port, &"/busy", &none, &"{}", 5000)
    f = f + ck_int(hs_status(&h2), 429, 38)
    rest = hs_read_rest(&mut h2)
    f = f + ck_int(sk_contains(&rest, &"\"len\""), 1, 39)
    x = hs_close(&mut h2)
    h3 = hs_open(&local, 18932, &"/sse", &none, &"{}", 1000)
    f = f + ck_int(hs_status(&h3), 0, 40)
    f = f + ck_int(hs_error(&h3).len() > 0, 1, 41)
    x = hs_close(&mut h3)

    x = kill_pid(pid, 9)
    x = wait_pid(pid)
    f
