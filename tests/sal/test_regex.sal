import "../../regex.sal"
import "support/assert.sal"

# 1 si el patrón casa en algún punto del texto.
fn t(pat: String, text: String, want: Int, code: Int) -> Int ! io, alloc
    re = regex_compile(pat, 0)
    if regex_ok(re) == 0
        return ck_fail(code, "compile error: " + regex_error(re), "ok")
    ck_int(regex_test(re, text), want, code)

fn ti(pat: String, text: String, want: Int, code: Int) -> Int ! io, alloc
    re = regex_compile(pat, 1)
    ck_int(regex_test(re, text), want, code)

# Comprueba inicio y fin de la primera coincidencia.
fn span(pat: String, text: String, s: Int, e: Int, code: Int) -> Int ! io, alloc
    re = regex_compile(pat, 0)
    st = regex_find(re, text, 0)
    r = ck_int(st, s, code)
    r + ck_int(regex_end(re), e, code + 100)

fn main() -> Int ! io, alloc
    f = 0
    f = f + t("abc", "xxabcxx", 1, 1)
    f = f + t("abc", "xxabxcxx", 0, 2)
    f = f + t("a.c", "abc", 1, 3)
    f = f + t("a.*c", "a123c", 1, 4)
    f = f + t("^abc", "abcd", 1, 5)
    f = f + t("^abc", "xabc", 0, 6)
    f = f + t("abc$", "xabc", 1, 7)
    f = f + t("abc$", "abcx", 0, 8)
    f = f + t("colou?r", "color", 1, 9)
    f = f + t("colou?r", "colour", 1, 10)
    f = f + t("a+b", "aaab", 1, 11)
    f = f + t("a+b", "b", 0, 12)
    f = f + t("a*b", "b", 1, 13)
    f = f + t("foo|bar", "xxbarxx", 1, 14)
    f = f + t("foo|bar", "xxbazxx", 0, 15)
    f = f + t("(foo|bar)_baz", "bar_baz", 1, 16)
    f = f + t("(foo|bar)_baz", "baz_baz", 0, 17)
    f = f + t("(ab)+c", "ababc", 1, 18)
    f = f + t("(ab)+c", "aabbc", 0, 19)
    f = f + t("(?:ab)*c", "c", 1, 20)
    f = f + t("[abc]+x", "cabx", 1, 21)
    f = f + t("[a-c]x", "dx", 0, 22)
    f = f + t("[^a-c]x", "dx", 1, 23)
    f = f + t("[^a-c]x", "bx", 0, 24)
    f = f + t("\\d+", "abc 123", 1, 25)
    f = f + t("^\\d+$", "123a", 0, 26)
    f = f + t("\\w+\\s\\w+", "hello world", 1, 27)
    f = f + t("\\bfoo\\b", "a foo b", 1, 28)
    f = f + t("\\bfoo\\b", "afoo b", 0, 29)
    f = f + t("\\Bfoo", "afoo", 1, 30)
    f = f + t("a\\.b", "a.b", 1, 31)
    f = f + t("a\\.b", "axb", 0, 32)
    f = f + t("x{2}", "axxb", 1, 33)
    f = f + t("x{2}", "axb", 0, 34)
    f = f + t("^x{2,3}$", "xxxx", 0, 35)
    f = f + t("^x{2,3}$", "xxx", 1, 36)
    f = f + t("^x{2,}$", "xxxxxx", 1, 37)
    f = f + t("^x{2,}$", "x", 0, 38)
    f = f + t("fn\\s+\\w+\\(", "pub fn main() {", 1, 39)
    f = f + t("[[]x]", "[x]", 1, 40)
    f = f + t("a{", "a{", 1, 41)
    f = f + t("TODO|FIXME", "// FIXME later", 1, 42)
    f = f + t("", "anything", 1, 43)
    f = f + t("a|", "zzz", 1, 44)
    f = f + t("(a*)*b", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaac", 0, 45)
    f = f + t("(a*)*b", "aaab", 1, 46)
    f = f + t("x*", "", 1, 47)
    f = f + ti("hello", "Say HeLLo", 1, 48)
    f = f + ti("[a-z]+", "ABC", 1, 49)
    f = f + t("[a-z]+", "ABC", 0, 50)
    f = f + t("a.c", "a" + String.from_char(10) + "c", 0, 51)

    f = f + span("b+", "aabbbcc", 2, 5, 60)
    f = f + span("a|ab", "xab", 1, 3, 61)
    f = f + span("x*", "aaa", 0, 0, 62)
    f = f + span("\\d+", "ab 1234 5", 3, 7, 63)

    # errores de sintaxis
    f = f + ck_int(regex_ok(regex_compile("(abc", 0)), 0, 70)
    f = f + ck_int(regex_ok(regex_compile("abc)", 0)), 0, 71)
    f = f + ck_int(regex_ok(regex_compile("[abc", 0)), 0, 72)
    f = f + ck_int(regex_ok(regex_compile("*a", 0)), 0, 73)
    f = f + ck_int(regex_ok(regex_compile("a\\", 0)), 0, 74)
    f = f + ck_int(regex_ok(regex_compile("a{3,2}", 0)), 0, 75)

    f = f + ck_int(regex_is_literal("hello world"), 1, 80)
    f = f + ck_int(regex_is_literal("a.b"), 0, 81)
    f = f + ck_str(regex_escape("a.b*(c)"), "a\\.b\\*\\(c\\)", 82)
    f = f + t(regex_escape("a.b*(c)"), "xa.b*(c)y", 1, 83)
    f = f + t(regex_escape("a.b*(c)"), "xaXb*(c)y", 0, 84)
    f
