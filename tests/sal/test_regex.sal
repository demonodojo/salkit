import "../../regex.sal"
import "support/assert.sal"

# 1 si el patrón casa en algún punto del texto.
fn t(pat: &String, text: &String, want: Int, code: Int) -> Int ! io, alloc
    re = regex_compile(pat, 0)
    if regex_ok(&re) == 0
        msg = "compile error: " + regex_error(&re)
        return ck_fail(code, &msg, &"ok")
    regex_test(&mut re, text)

fn ck_test(pat: &String, text: &String, want: Int, code: Int) -> Int ! io, alloc
    ck_int(t(pat, text, want, code), want, code)

fn ti(pat: &String, text: &String, want: Int, code: Int) -> Int ! io, alloc
    re = regex_compile(pat, 1)
    ck_int(regex_test(&mut re, text), want, code)

# Comprueba inicio y fin de la primera coincidencia.
fn span(pat: &String, text: &String, s: Int, e: Int, code: Int) -> Int ! io, alloc
    re = regex_compile(pat, 0)
    st = regex_find(&mut re, text, 0)
    r = ck_int(st, s, code)
    r + ck_int(regex_end(&re), e, code + 100)

# 1 si el patrón no compila.
fn broken(pat: &String, code: Int) -> Int ! io, alloc
    re = regex_compile(pat, 0)
    ck_int(regex_ok(&re), 0, code)

fn main() -> Int ! io, alloc
    f = 0
    f = f + ck_test(&"abc", &"xxabcxx", 1, 1)
    f = f + ck_test(&"abc", &"xxabxcxx", 0, 2)
    f = f + ck_test(&"a.c", &"abc", 1, 3)
    f = f + ck_test(&"a.*c", &"a123c", 1, 4)
    f = f + ck_test(&"^abc", &"abcd", 1, 5)
    f = f + ck_test(&"^abc", &"xabc", 0, 6)
    f = f + ck_test(&"abc$", &"xabc", 1, 7)
    f = f + ck_test(&"abc$", &"abcx", 0, 8)
    f = f + ck_test(&"colou?r", &"color", 1, 9)
    f = f + ck_test(&"colou?r", &"colour", 1, 10)
    f = f + ck_test(&"a+b", &"aaab", 1, 11)
    f = f + ck_test(&"a+b", &"b", 0, 12)
    f = f + ck_test(&"a*b", &"b", 1, 13)
    f = f + ck_test(&"foo|bar", &"xxbarxx", 1, 14)
    f = f + ck_test(&"foo|bar", &"xxbazxx", 0, 15)
    f = f + ck_test(&"(foo|bar)_baz", &"bar_baz", 1, 16)
    f = f + ck_test(&"(foo|bar)_baz", &"baz_baz", 0, 17)
    f = f + ck_test(&"(ab)+c", &"ababc", 1, 18)
    f = f + ck_test(&"(ab)+c", &"aabbc", 0, 19)
    f = f + ck_test(&"(?:ab)*c", &"c", 1, 20)
    f = f + ck_test(&"[abc]+x", &"cabx", 1, 21)
    f = f + ck_test(&"[a-c]x", &"dx", 0, 22)
    f = f + ck_test(&"[^a-c]x", &"dx", 1, 23)
    f = f + ck_test(&"[^a-c]x", &"bx", 0, 24)
    f = f + ck_test(&"\\d+", &"abc 123", 1, 25)
    f = f + ck_test(&"^\\d+$", &"123a", 0, 26)
    f = f + ck_test(&"\\w+\\s\\w+", &"hello world", 1, 27)
    f = f + ck_test(&"\\bfoo\\b", &"a foo b", 1, 28)
    f = f + ck_test(&"\\bfoo\\b", &"afoo b", 0, 29)
    f = f + ck_test(&"\\Bfoo", &"afoo", 1, 30)
    f = f + ck_test(&"a\\.b", &"a.b", 1, 31)
    f = f + ck_test(&"a\\.b", &"axb", 0, 32)
    f = f + ck_test(&"x{2}", &"axxb", 1, 33)
    f = f + ck_test(&"x{2}", &"axb", 0, 34)
    f = f + ck_test(&"^x{2,3}$", &"xxxx", 0, 35)
    f = f + ck_test(&"^x{2,3}$", &"xxx", 1, 36)
    f = f + ck_test(&"^x{2,}$", &"xxxxxx", 1, 37)
    f = f + ck_test(&"^x{2,}$", &"x", 0, 38)
    f = f + ck_test(&"fn\\s+\\w+\\(", &"pub fn main() {", 1, 39)
    f = f + ck_test(&"[[]x]", &"[x]", 1, 40)
    f = f + ck_test(&"a{", &"a{", 1, 41)
    f = f + ck_test(&"TODO|FIXME", &"// FIXME later", 1, 42)
    f = f + ck_test(&"", &"anything", 1, 43)
    f = f + ck_test(&"a|", &"zzz", 1, 44)
    f = f + ck_test(&"(a*)*b", &"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaac", 0, 45)
    f = f + ck_test(&"(a*)*b", &"aaab", 1, 46)
    f = f + ck_test(&"x*", &"", 1, 47)
    f = f + ti(&"hello", &"Say HeLLo", 1, 48)
    f = f + ti(&"[a-z]+", &"ABC", 1, 49)
    f = f + ck_test(&"[a-z]+", &"ABC", 0, 50)
    newline = String.from_char(10)
    with_nl = "a" + newline + "c"
    f = f + ck_test(&"a.c", &with_nl, 0, 51)

    f = f + span(&"b+", &"aabbbcc", 2, 5, 60)
    f = f + span(&"a|ab", &"xab", 1, 3, 61)
    f = f + span(&"x*", &"aaa", 0, 0, 62)
    f = f + span(&"\\d+", &"ab 1234 5", 3, 7, 63)

    # errores de sintaxis
    f = f + broken(&"(abc", 70)
    f = f + broken(&"abc)", 71)
    f = f + broken(&"[abc", 72)
    f = f + broken(&"*a", 73)
    f = f + broken(&"a\\", 74)
    f = f + broken(&"a{3,2}", 75)

    f = f + ck_int(regex_is_literal(&"hello world"), 1, 80)
    f = f + ck_int(regex_is_literal(&"a.b"), 0, 81)
    pattern = "a.b*(c)"
    escaped = regex_escape(&pattern)
    f = f + ck_str(&escaped, &"a\\.b\\*\\(c\\)", 82)
    f = f + ck_test(&escaped, &"xa.b*(c)y", 1, 83)
    f = f + ck_test(&escaped, &"xaXb*(c)y", 0, 84)
    f
