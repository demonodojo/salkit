import "../../fsx.sal"
import "../../strbuf.sal"
import "support/assert.sal"

fn main() -> Int ! io, alloc
    f = 0
    root = "target/fsx-test"
    a = root + "/a.txt"
    deep = root + "/sub/deep/b.txt"
    log = root + "/sub/c.log"
    sub = root + "/sub"
    missing = root + "/missing"
    gone = root + "/nope"
    comma = ","
    x = fsx_remove(&a)
    x = fsx_remove(&deep)
    x = fsx_remove(&log)
    f = f + ck_int(fsx_write(&a, &"hello\nworld\n"), 0, 1)
    f = f + ck_int(fsx_write(&deep, &"bbb"), 0, 2)
    f = f + ck_int(fsx_write(&log, &"c"), 0, 3)
    f = f + ck_str(&fsx_read_text(&a), &"hello\nworld\n", 4)
    f = f + ck_int(fsx_append(&a, &"more"), 0, 5)
    f = f + ck_str(&fsx_read_text(&a), &"hello\nworld\nmore", 6)
    f = f + ck_int(fsx_size(&a), 16, 7)
    f = f + ck_int(fsx_exists(&gone), 0, 8)
    f = f + ck_str(&fsx_read_text(&gone), &"", 9)
    b0 = fsx_read_bytes(&gone)
    f = f + ck_int(b0.len(), 0, 10)
    f = f + ck_int(fsx_is_dir(&sub), 1, 11)
    f = f + ck_int(fsx_is_file(&sub), 0, 12)
    f = f + ck_int(fsx_is_file(&a), 1, 13)
    f = f + ck_str(&fsx_read_text_max(&a, 5), &"hello", 14)
    names = fsx_list_dir(&root)
    listed = sk_join(&names, &comma)
    f = f + ck_str(&listed, &"a.txt,sub/", 15)
    ign = sk_sl_new()
    all = fsx_walk(&root, &ign, 100)
    walked = sk_join(&all, &comma)
    f = f + ck_str(&walked, &"a.txt,sub/c.log,sub/deep/b.txt", 16)
    sk_sl_push(&mut ign, "deep".clone())
    ignored = fsx_walk(&root, &ign, 100)
    walked2 = sk_join(&ignored, &comma)
    f = f + ck_str(&walked2, &"a.txt,sub/c.log", 17)
    capped = fsx_walk(&root, &sk_sl_new(), 2)
    f = f + ck_int(capped.len(), 2, 18)
    absent = fsx_list_dir(&missing)
    f = f + ck_int(absent.len(), 0, 19)
    f
