# salkit/regex.sal — expresiones regulares (NFA tipo Pike, tiempo lineal, sin backtracking).
#
# Sintaxis: literales . [abc] [a-z] [^x] \d \w \s \D \W \S \b \B ^ $ | ( ) (?: )
#           * + ? {n} {n,} {n,m} (y sus variantes perezosas, que se tratan como voraces).
# Semántica: el primer inicio posible (más a la izquierda) con la coincidencia más larga.
# El texto se trata como una sola línea: ^ y $ son el inicio y el final del texto.
#
# El programa compilado es un struct `Regex` que posee sus listas y su mensaje de error;
# lo libera al salir de ámbito. El texto se presta. Las funciones del parser y del
# emparejador mutan el programa (`&mut Regex`); las de consulta lo leen (`&Regex`).

import "strbuf.sal"
import "int.sal"

struct Regex
    ops: List[Int]
    xs: List[Int]
    ys: List[Int]
    icase: Int
    firstset: List[Int]
    nullable: Int
    end: Int
    classes: List[List[Int]]
    err: String
    ppos: Int
    marks: List[Int]
    gen: Int
    ast: RxAst
    bmin: Int
    bmax: Int
    bpos: Int

fn regex_ok(re: &Regex) -> Int
    if re.err.len() == 0
        1
    else
        0

fn regex_error(re: &Regex) -> &String
    &re.err

# Fin de la última coincidencia encontrada con regex_find.
fn regex_end(re: &Regex) -> Int
    re.end

# ---------------------------------------------------------------- AST

# Nodos: 1 CHAR(a), 2 ANY, 3 CLASS(a), 4 BOL, 5 EOL, 6 WB, 7 NWB, 8 GROUP(first),
# 9 CAT(hijos), 10 ALT(a,b), 11 REPEAT(a,min=b,max=c), 12 EMPTY.
# El AST es un `RxAst`: listas paralelas con nombre; cada nodo es un índice Int (-1 = ninguno).

struct RxAst
    kind: List[Int]
    a: List[Int]
    b: List[Int]
    c: List[Int]
    first: List[Int]
    last: List[Int]
    next: List[Int]

fn rxa_empty() -> RxAst ! alloc
    RxAst(List.new[Int](), List.new[Int](), List.new[Int](), List.new[Int](), List.new[Int](), List.new[Int](), List.new[Int]())

fn rxa_new(re: &mut Regex, kind: Int, a: Int, b: Int, c: Int) -> Int ! alloc
    id = re.ast.kind.len()
    re.ast.kind.push(kind)
    re.ast.a.push(a)
    re.ast.b.push(b)
    re.ast.c.push(c)
    re.ast.first.push(0 - 1)
    re.ast.last.push(0 - 1)
    re.ast.next.push(0 - 1)
    id

fn rxa_add(re: &mut Regex, parent: Int, child: Int) -> Int ! alloc
    last = re.ast.last.get(parent)
    if last < 0
        re.ast.first.set(parent, child)
    else
        re.ast.next.set(last, child)
    re.ast.last.set(parent, child)
    child

fn rxa_kind(ast: &RxAst, n: Int) -> Int
    ast.kind.get(n)

fn rxa_a(ast: &RxAst, n: Int) -> Int
    ast.a.get(n)

fn rxa_b(ast: &RxAst, n: Int) -> Int
    ast.b.get(n)

fn rxa_c(ast: &RxAst, n: Int) -> Int
    ast.c.get(n)

fn rxa_first(ast: &RxAst, n: Int) -> Int
    ast.first.get(n)

fn rxa_next(ast: &RxAst, n: Int) -> Int
    ast.next.get(n)

# ---------------------------------------------------------------- clases

fn rx_is_word(c: Int) -> Int
    if c >= 97
        if c <= 122
            return 1
    if c >= 65
        if c <= 90
            return 1
    if c >= 48
        if c <= 57
            return 1
    if c == 95
        return 1
    0

fn rx_swap_case(c: Int) -> Int
    if c >= 97
        if c <= 122
            return c - 32
    if c >= 65
        if c <= 90
            return c + 32
    c

fn rx_lower(c: Int) -> Int
    if c >= 65
        if c <= 90
            return c + 32
    c

# Clase = vec [neg, lo1, hi1, lo2, hi2, ...]; devuelve su índice en la tabla.
fn rxp_new_class(re: &mut Regex, neg: Int) -> Int ! alloc
    cl = List.new[Int]()
    cl.push(neg)
    id = re.classes.len()
    re.classes.push(cl)
    id

fn rxp_class_range(re: &mut Regex, idx: Int, lo: Int, hi: Int) -> Int ! alloc
    re.classes.get_mut(idx).push(lo)
    re.classes.get_mut(idx).push(hi)
    0

# Añade a la clase los rangos de \d, \w o \s (kind = d, w, s).
fn rxp_class_shorthand(re: &mut Regex, idx: Int, kind: Int) -> Int ! alloc
    if kind == 100
        x = rxp_class_range(re, idx, 48, 57)
    if kind == 119
        x = rxp_class_range(re, idx, 48, 57)
        x = rxp_class_range(re, idx, 65, 90)
        x = rxp_class_range(re, idx, 97, 122)
        x = rxp_class_range(re, idx, 95, 95)
    if kind == 115
        x = rxp_class_range(re, idx, 9, 13)
        x = rxp_class_range(re, idx, 32, 32)
    0

fn rxm_class_has(cl: &List[Int], c: Int) -> Int
    n = cl.len()
    i = 1
    while i + 1 < n
        if c >= cl.get(i)
            if c <= cl.get(i + 1)
                return 1
        i = i + 2
    0

fn rxm_class(re: &Regex, idx: Int, c: Int) -> Int
    cl = re.classes.get(idx)
    hit = rxm_class_has(cl, c)
    if hit == 0
        if re.icase != 0
            alt = rx_swap_case(c)
            if alt != c
                hit = rxm_class_has(cl, alt)
    if cl.get(0) != 0
        if hit != 0
            return 0
        return 1
    hit

# ---------------------------------------------------------------- parser

# No asigna re.err aquí: hacerlo vía &mut a mitad del parse corrompe el heap
# (bug del compilador con String en struct mientras el AST se muta). Se guarda
# posición + mensaje en marks (aún vacío); regex_compile lo materializa al fallar.
fn rxp_fail(re: &mut Regex, msg: &String) -> Int ! alloc
    if re.gen == 0
        re.gen = 1
        re.marks.push(re.ppos)
        i = 0
        n = msg.len()
        while i < n
            re.marks.push(msg.char(i))
            i = i + 1
    0 - 1

fn rxp_peek(re: &Regex, pat: &String) -> Int
    p = re.ppos
    if p >= pat.len()
        0 - 1
    else
        pat.char(p)

fn rxp_eat(re: &mut Regex) -> Int
    re.ppos = re.ppos + 1
    0

fn rxp_alt(re: &mut Regex, pat: &String) -> Int ! alloc
    left = rxp_cat(re, pat)
    if left < 0
        return 0 - 1
    while rxp_peek(re, pat) == 124
        rxp_eat(re)
        right = rxp_cat(re, pat)
        if right < 0
            return 0 - 1
        left = rxa_new(re, 10, left, right, 0)
    left

fn rxp_cat(re: &mut Regex, pat: &String) -> Int ! alloc
    node = rxa_new(re, 9, 0, 0, 0)
    go = 1
    while go != 0
        c = rxp_peek(re, pat)
        if c < 0
            go = 0
        elsif c == 124
            go = 0
        elsif c == 41
            go = 0
        else
            atom = rxp_quant(re, pat)
            if atom < 0
                return 0 - 1
            x = rxa_add(re, node, atom)
    node

# Posición tras la racha de dígitos que empieza en p.
fn rxp_digits_end(pat: &String, p: Int) -> Int
    n = pat.len()
    i = p
    while i < n
        c = pat.char(i)
        if c < 48
            return i
        if c > 57
            return i
        i = i + 1
    i

# Intenta leer {n}, {n,} o {n,m} desde "{" en la posición actual (sin consumir).
# Si es válido devuelve 1 y deja min en re.bmin, max en re.bmax (-1 = sin límite)
# y la posición siguiente en re.bpos.
fn rxp_brace(re: &mut Regex, pat: &String) -> Int ! alloc
    n = pat.len()
    ds = re.ppos + 1
    de = rxp_digits_end(pat, ds)
    if de == ds
        return 0
    if de >= n
        return 0
    lo_text = pat.slice(ds, de)
    lo = sk_parse_int(&lo_text)
    c = pat.char(de)
    if c == 125
        re.bmin = lo
        re.bmax = lo
        re.bpos = de + 1
        return 1
    if c != 44
        return 0
    ms = de + 1
    me = rxp_digits_end(pat, ms)
    if me >= n
        return 0
    if pat.char(me) != 125
        return 0
    hi = 0 - 1
    if me > ms
        hi_text = pat.slice(ms, me)
        hi = sk_parse_int(&hi_text)
    re.bmin = lo
    re.bmax = hi
    re.bpos = me + 1
    1

fn rxp_quant(re: &mut Regex, pat: &String) -> Int ! alloc
    atom = rxp_atom(re, pat)
    if atom < 0
        return 0 - 1
    c = rxp_peek(re, pat)
    mn = 0 - 1
    mx = 0 - 1
    if c == 42
        mn = 0
        mx = 0 - 1
        x = rxp_eat(re)
    elsif c == 43
        mn = 1
        mx = 0 - 1
        x = rxp_eat(re)
    elsif c == 63
        mn = 0
        mx = 1
        x = rxp_eat(re)
    elsif c == 123
        if rxp_brace(re, pat) != 0
            mn = re.bmin
            mx = re.bmax
            re.ppos = re.bpos
    if mn < 0
        return atom
    if mx >= 0
        if mx < mn
            return rxp_fail(re, &"bad repetition range")
    if mn > 1000
        return rxp_fail(re, &"repetition too large")
    if mx > 1000
        return rxp_fail(re, &"repetition too large")
    # sufijo perezoso (?) o posesivo (+): se ignora
    d = rxp_peek(re, pat)
    match d
        63 =>
            x = rxp_eat(re)
        43 =>
            x = rxp_eat(re)

    rxa_new(re, 11, atom, mn, mx)

fn rxp_atom(re: &mut Regex, pat: &String) -> Int ! alloc
    c = rxp_peek(re, pat)
    x = rxp_eat(re)
    if c == 40
        if rxp_peek(re, pat) == 63
            x = rxp_eat(re)
            if rxp_peek(re, pat) == 58
                x = rxp_eat(re)
            else
                return rxp_fail(re, &"unsupported group syntax")
        inner = rxp_alt(re, pat)
        if inner < 0
            return 0 - 1
        if rxp_peek(re, pat) != 41
            return rxp_fail(re, &"missing )")
        x = rxp_eat(re)
        g = rxa_new(re, 8, 0, 0, 0)
        x = rxa_add(re, g, inner)
        return g
    if c == 41
        return rxp_fail(re, &"unmatched )")
    if c == 46
        return rxa_new(re, 2, 0, 0, 0)
    if c == 94
        return rxa_new(re, 4, 0, 0, 0)
    if c == 36
        return rxa_new(re, 5, 0, 0, 0)
    if c == 91
        return rxp_bracket(re, pat)
    if c == 42
        return rxp_fail(re, &"nothing to repeat")
    if c == 43
        return rxp_fail(re, &"nothing to repeat")
    if c == 63
        return rxp_fail(re, &"nothing to repeat")
    if c == 92
        return rxp_escape(re, pat)
    rxa_new(re, 1, c, 0, 0)

fn rxp_escape(re: &mut Regex, pat: &String) -> Int ! alloc
    if re.ppos >= pat.len()
        return rxp_fail(re, &"trailing backslash")
    c = rxp_peek(re, pat)
    x = rxp_eat(re)
    if c == 100
        idx = rxp_new_class(re, 0)
        x = rxp_class_shorthand(re, idx, 100)
        return rxa_new(re, 3, idx, 0, 0)
    if c == 68
        idx = rxp_new_class(re, 1)
        x = rxp_class_shorthand(re, idx, 100)
        return rxa_new(re, 3, idx, 0, 0)
    if c == 119
        idx = rxp_new_class(re, 0)
        x = rxp_class_shorthand(re, idx, 119)
        return rxa_new(re, 3, idx, 0, 0)
    if c == 87
        idx = rxp_new_class(re, 1)
        x = rxp_class_shorthand(re, idx, 119)
        return rxa_new(re, 3, idx, 0, 0)
    if c == 115
        idx = rxp_new_class(re, 0)
        x = rxp_class_shorthand(re, idx, 115)
        return rxa_new(re, 3, idx, 0, 0)
    if c == 83
        idx = rxp_new_class(re, 1)
        x = rxp_class_shorthand(re, idx, 115)
        return rxa_new(re, 3, idx, 0, 0)
    if c == 98
        return rxa_new(re, 6, 0, 0, 0)
    if c == 66
        return rxa_new(re, 7, 0, 0, 0)
    if c == 110
        return rxa_new(re, 1, 10, 0, 0)
    if c == 116
        return rxa_new(re, 1, 9, 0, 0)
    if c == 114
        return rxa_new(re, 1, 13, 0, 0)
    rxa_new(re, 1, c, 0, 0)

# Clase entre corchetes; "[" ya consumido.
fn rxp_bracket(re: &mut Regex, pat: &String) -> Int ! alloc
    n = pat.len()
    neg = 0
    if rxp_peek(re, pat) == 94
        neg = 1
        x = rxp_eat(re)
    idx = rxp_new_class(re, neg)
    first = 1
    while re.ppos < n
        c = rxp_peek(re, pat)
        x = rxp_eat(re)
        if c == 93
            if first == 0
                return rxa_new(re, 3, idx, 0, 0)
        first = 0
        lo = c
        if c == 92
            if re.ppos >= n
                return rxp_fail(re, &"trailing backslash")
            e = rxp_peek(re, pat)
            x = rxp_eat(re)
            lo = e
            match e
                100 =>
                    x = rxp_class_shorthand(re, idx, 100)
                    lo = 0 - 1
                119 =>
                    x = rxp_class_shorthand(re, idx, 119)
                    lo = 0 - 1
                115 =>
                    x = rxp_class_shorthand(re, idx, 115)
                    lo = 0 - 1
                110 =>
                    lo = 10
                116 =>
                    lo = 9
                114 =>
                    lo = 13

        if lo >= 0
            hi = lo
            if rxp_peek(re, pat) == 45
                p = re.ppos
                if p + 1 < n
                    if pat.char(p + 1) != 93
                        x = rxp_eat(re)
                        hi = rxp_peek(re, pat)
                        x = rxp_eat(re)
                        if hi == 92
                            hi = rxp_peek(re, pat)
                            x = rxp_eat(re)
            x = rxp_class_range(re, idx, lo, hi)
    rxp_fail(re, &"missing ]")

# ---------------------------------------------------------------- compilador

# Operaciones: 1 CHAR, 2 ANY, 3 CLASS, 4 SPLIT(x preferido, y), 5 JMP, 6 MATCH,
# 7 BOL, 8 EOL, 9 WB, 10 NWB.
fn rxc_push(re: &mut Regex, op: Int, x: Int, y: Int) -> Int ! alloc
    pc = re.ops.len()
    re.ops.push(op)
    re.xs.push(x)
    re.ys.push(y)
    pc

fn rxc_pc(re: &Regex) -> Int
    re.ops.len()

fn rxc_emit(re: &mut Regex, n: Int) -> Int ! alloc
    if re.ops.len() > 20000
        return rxp_fail(re, &"pattern too large")
    k = rxa_kind(&re.ast, n)
    if k == 1
        c = rxa_a(&re.ast, n)
        if re.icase != 0
            c = rx_lower(c)
        x = rxc_push(re, 1, c, 0)
    if k == 2
        x = rxc_push(re, 2, 0, 0)
    if k == 3
        x = rxc_push(re, 3, rxa_a(&re.ast, n), 0)
    if k == 4
        x = rxc_push(re, 7, 0, 0)
    if k == 5
        x = rxc_push(re, 8, 0, 0)
    if k == 6
        x = rxc_push(re, 9, 0, 0)
    if k == 7
        x = rxc_push(re, 10, 0, 0)
    if k == 8
        x = rxc_emit(re, rxa_first(&re.ast, n))
    if k == 9
        c = rxa_first(&re.ast, n)
        while c >= 0
            x = rxc_emit(re, c)
            nxt = rxa_next(&re.ast, c)
            c = nxt
    if k == 10
        sp = rxc_push(re, 4, 0, 0)
        x = re.xs.set(sp, sp + 1)
        x = rxc_emit(re, rxa_a(&re.ast, n))
        jp = rxc_push(re, 5, 0, 0)
        x = re.ys.set(sp, rxc_pc(re))
        x = rxc_emit(re, rxa_b(&re.ast, n))
        x = re.xs.set(jp, rxc_pc(re))
    if k == 11
        x = rxc_repeat(re, n)
    0

fn rxc_repeat(re: &mut Regex, n: Int) -> Int ! alloc
    body = rxa_a(&re.ast, n)
    mn = rxa_b(&re.ast, n)
    mx = rxa_c(&re.ast, n)
    i = 0
    while i < mn
        x = rxc_emit(re, body)
        i = i + 1
    if mx < 0
        l1 = rxc_push(re, 4, 0, 0)
        x = re.xs.set(l1, l1 + 1)
        x = rxc_emit(re, body)
        x = rxc_push(re, 5, l1, 0)
        x = re.ys.set(l1, rxc_pc(re))
        return 0
    splits = List.new[Int]()
    j = mn
    while j < mx
        sp = rxc_push(re, 4, 0, 0)
        x = re.xs.set(sp, sp + 1)
        splits.push(sp)
        x = rxc_emit(re, body)
        j = j + 1
    endpc = rxc_pc(re)
    q = 0
    while q < splits.len()
        x = re.ys.set(splits.get(q), endpc)
        q = q + 1
    0

# ---------------------------------------------------------------- coincidencia

fn rxm_gen(re: &mut Regex) -> Int
    g = re.gen + 1
    re.gen = g
    g

# Cierre por transiciones vacías desde pc; añade a `list` los estados que consumen o MATCH.
fn rxm_add(re: &mut Regex, list: &mut List[Int], cnt: Int, pc: Int, text: &String, i: Int, gen: Int) -> Int ! alloc
    if re.marks.get(pc) == gen
        return cnt
    re.marks.set(pc, gen)
    op = re.ops.get(pc)
    if op == 5
        nx = re.xs.get(pc)
        return rxm_add(re, list, cnt, nx, text, i, gen)
    if op == 4
        c1 = re.xs.get(pc)
        c2 = re.ys.get(pc)
        one = rxm_add(re, list, cnt, c1, text, i, gen)
        return rxm_add(re, list, one, c2, text, i, gen)
    if op == 7
        if i == 0
            return rxm_add(re, list, cnt, pc + 1, text, i, gen)
        return cnt
    if op == 8
        if i == text.len()
            return rxm_add(re, list, cnt, pc + 1, text, i, gen)
        return cnt
    if op == 9
        if rxm_boundary(text, i) != 0
            return rxm_add(re, list, cnt, pc + 1, text, i, gen)
        return cnt
    if op == 10
        if rxm_boundary(text, i) == 0
            return rxm_add(re, list, cnt, pc + 1, text, i, gen)
        return cnt
    if cnt < list.len()
        list.set(cnt, pc)
    else
        list.push(pc)
    cnt + 1

fn rxm_boundary(text: &String, i: Int) -> Int
    a = 0
    b = 0
    if i > 0
        a = rx_is_word(text.char(i - 1))
    if i < text.len()
        b = rx_is_word(text.char(i))
    if a != b
        1
    else
        0

# 1 si el estado `pc` (CHAR, ANY o CLASS) acepta el byte c.
fn rxm_accepts(re: &Regex, pc: Int, c: Int) -> Int
    op = re.ops.get(pc)
    x = re.xs.get(pc)
    if op == 1
        cc = c
        if re.icase != 0
            cc = rx_lower(c)
        if cc == x
            return 1
        return 0
    if op == 2
        if c == 10
            return 0
        return 1
    if op == 3
        return rxm_class(re, x, c)
    0

# Final de la coincidencia más larga que empieza exactamente en s, o -1.
fn rx_match_at(re: &mut Regex, text: &String, s: Int) -> Int ! alloc
    n = text.len()
    clist = List.new[Int]()
    nlist = List.new[Int]()
    ccnt = rxm_add(re, &mut clist, 0, 0, text, s, rxm_gen(re))
    best = 0 - 1
    i = s
    while ccnt > 0
        gen = rxm_gen(re)
        ncnt = 0
        k = 0
        while k < ccnt
            pc = clist.get(k)
            op = re.ops.get(pc)
            if op == 6
                best = i
            elsif i < n
                if rxm_accepts(re, pc, text.char(i)) != 0
                    ncnt = rxm_add(re, &mut nlist, ncnt, pc + 1, text, i + 1, gen)
            k = k + 1
        tmp = clist
        clist = nlist
        nlist = tmp
        ccnt = ncnt
        i = i + 1
    best

# Cierre de primeros bytes posibles desde pc (aserciones se atraviesan).
fn rxf_walk(re: &mut Regex, pc: Int, seen: &mut List[Int]) -> Int ! alloc
    if seen.get(pc) != 0
        return 0
    seen.set(pc, 1)
    op = re.ops.get(pc)
    if op == 5
        nx = re.xs.get(pc)
        return rxf_walk(re, nx, seen)
    if op == 4
        c1 = re.xs.get(pc)
        c2 = re.ys.get(pc)
        rxf_walk(re, c1, seen)
        return rxf_walk(re, c2, seen)
    if op == 6
        re.nullable = 1
        return 0
    if op == 7
        return rxf_walk(re, pc + 1, seen)
    if op == 8
        return rxf_walk(re, pc + 1, seen)
    if op == 9
        return rxf_walk(re, pc + 1, seen)
    if op == 10
        return rxf_walk(re, pc + 1, seen)
    b = 0
    while b < 256
        if rxm_accepts(re, pc, b) != 0
            re.firstset.set(b, 1)
        b = b + 1
    0

fn regex_compile(pat: &String, icase: Int) -> Regex ! alloc
    ast = rxa_empty()
    re = Regex(List.new[Int](), List.new[Int](), List.new[Int](), icase, List.new[Int](), 0, 0 - 1, List.new[List[Int]](), d"", 0, List.new[Int](), 0, ast, 0 - 1, 0 - 1, 0 - 1)
    root = rxp_alt(&mut re, pat)
    if root >= 0
        if re.ppos < pat.len()
            root = rxp_fail(&mut re, &"unmatched )")
    if root < 0
        epos = 0
        text = d""
        if re.marks.len() > 0
            epos = re.marks.get(0)
            i = 1
            while i < re.marks.len()
                ch = re.marks.get(i)
                text = text + String.from_char(ch)
                i = i + 1
        pos = epos.to_str()
        mid = text + " at position "
        re.err = mid + pos
        re.marks = List.new[Int]()
        re.gen = 0
        return re
    x = rxc_emit(&mut re, root)
    x = rxc_push(&mut re, 6, 0, 0)
    plen = rxc_pc(&re)
    k = 0
    while k <= plen
        re.marks.push(0)
        k = k + 1
    b = 0
    while b < 256
        re.firstset.push(0)
        b = b + 1
    seen = List.new[Int]()
    k = 0
    while k <= plen
        seen.push(0)
        k = k + 1
    x = rxf_walk(&mut re, 0, &mut seen)
    re

# Posición del inicio de la coincidencia más a la izquierda desde `from`, o -1.
# El final queda en regex_end(re).
fn regex_find(re: &mut Regex, text: &String, from: Int) -> Int ! alloc
    n = text.len()
    s = from
    if s < 0
        s = 0
    while s <= n
        try_it = 1
        if re.nullable == 0
            try_it = 0
            if s < n
                try_it = re.firstset.get(text.char(s))
        if try_it != 0
            e = rx_match_at(re, text, s)
            if e >= 0
                re.end = e
                return s
        s = s + 1
    0 - 1

fn regex_test(re: &mut Regex, text: &String) -> Int ! alloc
    if regex_find(re, text, 0) >= 0
        1
    else
        0

# 1 si el patrón no contiene metacaracteres (se puede buscar como texto plano).
fn regex_is_literal(pat: &String) -> Int
    n = pat.len()
    i = 0
    while i < n
        c = pat.char(i)
        if c == 92
            return 0
        if c == 46
            return 0
        if c == 42
            return 0
        if c == 43
            return 0
        if c == 63
            return 0
        if c == 40
            return 0
        if c == 41
            return 0
        if c == 91
            return 0
        if c == 93
            return 0
        if c == 123
            return 0
        if c == 125
            return 0
        if c == 124
            return 0
        if c == 94
            return 0
        if c == 36
            return 0
        i = i + 1
    1

# Escapa los metacaracteres para usar `s` como patrón literal.
fn regex_escape(s: &String) -> String ! alloc
    out = ""
    n = s.len()
    i = 0
    while i < n
        c = s.char(i)
        ch = String.from_char(c)
        if regex_is_literal(&ch) == 0
            out = out + String.from_char(92)
        out = out + String.from_char(c)
        i = i + 1
    out

# Filtro rápido sin reservar memoria: 1 si algún byte de text[lo..hi) puede iniciar una
# coincidencia (o el patrón admite coincidencia vacía). Si devuelve 0, la línea no casa.
fn regex_prefilter(re: &Regex, text: &String, lo: Int, hi: Int) -> Int
    if re.nullable != 0
        return 1
    i = lo
    while i < hi
        if re.firstset.get(text.char(i)) != 0
            return 1
        i = i + 1
    0
