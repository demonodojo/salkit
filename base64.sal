# salkit/base64.sal — codificación base64 estándar (RFC 4648) con relleno.

fn b64_char(v: Int) -> Int
    if v < 26
        return 65 + v
    if v < 52
        return 71 + v
    if v < 62
        return v - 4
    if v == 62
        return 43
    47

fn b64_encode(b: Bytes) -> String ! alloc
    n = b.len()
    m = (n + 2) / 3 * 4
    if m <= 0
        return ""
    out = Bytes.new(m)
    i = 0
    o = 0
    while i + 2 < n
        v = (b.get_u8(i) << 16) | (b.get_u8(i + 1) << 8) | b.get_u8(i + 2)
        x = out.set_u8(o, b64_char((v >> 18) & 63))
        x = out.set_u8(o + 1, b64_char((v >> 12) & 63))
        x = out.set_u8(o + 2, b64_char((v >> 6) & 63))
        x = out.set_u8(o + 3, b64_char(v & 63))
        i = i + 3
        o = o + 4
    rest = n - i
    if rest == 1
        v = b.get_u8(i) << 16
        x = out.set_u8(o, b64_char((v >> 18) & 63))
        x = out.set_u8(o + 1, b64_char((v >> 12) & 63))
        x = out.set_u8(o + 2, 61)
        x = out.set_u8(o + 3, 61)
    if rest == 2
        v = (b.get_u8(i) << 16) | (b.get_u8(i + 1) << 8)
        x = out.set_u8(o, b64_char((v >> 18) & 63))
        x = out.set_u8(o + 1, b64_char((v >> 12) & 63))
        x = out.set_u8(o + 2, b64_char((v >> 6) & 63))
        x = out.set_u8(o + 3, 61)
    bytes_view(out, 0, m).to_str()

fn b64_encode_str(s: String) -> String ! alloc
    n = s.len()
    if n <= 0
        return ""
    b = Bytes.new(n)
    b.write_str(0, s)
    b64_encode(b)
