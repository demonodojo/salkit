# salkit/int.sal — conversión de texto a entero (std no trae parseo decimal).

# Valor del dígito `c` en base 16 (0-15), o -1 si no es un dígito hexadecimal.
fn sk_hex_digit(c: Int) -> Int
    if c >= 48
        if c <= 57
            return c - 48
    if c >= 97
        if c <= 102
            return c - 87
    if c >= 65
        if c <= 70
            return c - 55
    0 - 1

# 1 si `s` es un entero decimal con signo opcional y al menos un dígito.
fn sk_is_int(s: String) -> Int
    n = s.len()
    i = 0
    if n > 0
        if s.char(0) == 45
            i = 1
    if i >= n
        return 0
    while i < n
        c = s.char(i)
        if c < 48
            return 0
        if c > 57
            return 0
        i = i + 1
    1

# Entero decimal con signo opcional; se detiene en el primer carácter no numérico.
# Devuelve 0 si no hay dígitos.
fn sk_parse_int(s: String) -> Int
    n = s.len()
    i = 0
    neg = 0
    if n > 0
        if s.char(0) == 45
            neg = 1
            i = 1
    acc = 0
    while i < n
        c = s.char(i)
        if c < 48
            i = n
        elsif c > 57
            i = n
        else
            acc = acc * 10 + (c - 48)
            i = i + 1
    if neg != 0
        0 - acc
    else
        acc

# Entero hexadecimal sin prefijo; se detiene en el primer dígito inválido.
fn sk_parse_hex(s: String) -> Int
    n = s.len()
    i = 0
    acc = 0
    while i < n
        d = sk_hex_digit(s.char(i))
        if d < 0
            i = n
        else
            acc = acc * 16 + d
            i = i + 1
    acc
