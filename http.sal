# salkit/http.sal — cliente HTTP/1.1 en texto plano (sin TLS) para LAN y loopback.
#
# El resultado es un struct `HttpResult`: http_status (0 si no hubo respuesta), http_body,
# http_error ("" si todo fue bien), http_header(r, nombre) sin distinguir mayúsculas.
# Una petición abre su propia conexión (Connection: close) y respeta un plazo total.

import "io/io.sal"
import "io/net.sal"
import "io/time.sal"
import "strbuf.sal"
import "int.sal"

struct HttpResult
    status: Int
    body: String
    err: String
    headers: String

fn http_status(r: HttpResult) -> Int
    r.status

fn http_body(r: HttpResult borrow) -> String ! alloc
    r.body.slice(0, r.body.len())

fn http_error(r: HttpResult borrow) -> String ! alloc
    r.err.slice(0, r.err.len())

# Cabeceras crudas de la respuesta (sin la línea de estado).
fn http_headers_raw(r: HttpResult borrow) -> String ! alloc
    r.headers.slice(0, r.headers.len())

# 1 si la respuesta es 2xx.
fn http_is_ok(r: HttpResult) -> Int
    s = r.status
    if s >= 200
        if s < 300
            return 1
    0

fn http_result(status: Int, body: String, err: String, headers: String) -> HttpResult
    HttpResult(status, body, err, headers)

# Valor de una cabecera (primera coincidencia, sin distinguir mayúsculas); "" si no está.
fn http_header_in(headers: String, name: String) -> String ! alloc
    lines = sk_split_lines(headers)
    want = sk_lower(name)
    n = sk_sl_len(lines)
    i = 0
    while i < n
        line = sk_sl_get(lines, i)
        c = sk_index_of(line, ":")
        if c > 0
            if sk_lower(line.slice(0, c)).eq(want) != 0
                return sk_trim(line.slice(c + 1, line.len()))
        i = i + 1
    ""

fn http_header(r: HttpResult, name: String) -> String ! alloc
    http_header_in(http_headers_raw(r), name)

# Decodifica un cuerpo con Transfer-Encoding: chunked.
fn http_dechunk(raw: String) -> String ! alloc
    n = raw.len()
    out = ""
    i = 0
    go = 1
    while go != 0
        e = sk_index_from(raw, "\r\n", i)
        if e < 0
            go = 0
        else
            size = sk_parse_hex(raw.slice(i, e))
            if size <= 0
                go = 0
            else
                start = e + 2
                stop = start + size
                if stop > n
                    stop = n
                out = out + raw.slice(start, stop)
                i = stop + 2
                if i >= n
                    go = 0
    out

# Escribe todo `data` en el socket; 0 si ok.
fn http_send_all(fd: Int, data: String) -> Int ! io, alloc
    n = data.len()
    buf = Bytes.new(n)
    buf.write_str(0, data)
    pos = 0
    while pos < n
        k = Fd.new(fd).write(buf.ptr() + pos, n - pos)
        if k <= 0
            return 1
        pos = pos + k
    0

fn http_connect(host: String, port: Int, timeout_ms: Int) -> Int ! io, alloc
    if host.eq("127.0.0.1") != 0
        return tcp_connect_loopback(port, timeout_ms)
    if host.eq("localhost") != 0
        return tcp_connect_loopback(port, timeout_ms)
    tcp_connect_host(host, port, timeout_ms)

# Petición genérica. `extra_headers` son líneas "Nombre: valor" separadas por "\r\n"
# (puede ser ""). `timeout_ms` es el plazo total; `max_bytes` limita la respuesta.
fn http_request(method: String, host: String, port: Int, path: String, extra_headers: String, body: String, timeout_ms: Int, max_bytes: Int) -> HttpResult ! io, alloc
    fd = http_connect(host, port, 5000)
    if fd < 0
        return http_result(0, "", "connect failed to " + host + ":" + port.to_str(), "")
    req = method + " " + path + " HTTP/1.1\r\nHost: " + host + ":" + port.to_str() + "\r\nConnection: close\r\nAccept: */*\r\n"
    if extra_headers.len() > 0
        req = req + extra_headers + "\r\n"
    if body.len() > 0
        req = req + "Content-Length: " + body.len().to_str() + "\r\n"
    elsif method.eq("POST") != 0
        req = req + "Content-Length: 0\r\n"
    req = req + "\r\n" + body
    if http_send_all(fd, req) != 0
        Fd.new(fd).close()
        return http_result(0, "", "send failed", "")
    deadline = uptime_ms() + timeout_ms
    chunk = Bytes.new(65536)
    acc = ""
    hend = 0 - 1
    clen = 0 - 1
    chunked = 0
    timed_out = 0
    go = 1
    while go != 0
        left = deadline - uptime_ms()
        if left <= 0
            timed_out = 1
            go = 0
        else
            slice = left
            if slice > 200
                slice = 200
            k = Fd.new(fd).read_timeout(chunk.ptr(), 65536, slice)
            if k > 0
                acc = acc + bytes_view(chunk, 0, k).to_str()
                if hend < 0
                    hend = sk_index_of(acc, "\r\n\r\n")
                    if hend >= 0
                        hdrs = acc.slice(0, hend)
                        cl = http_header_in(hdrs, "content-length")
                        if cl.len() > 0
                            clen = sk_parse_int(cl)
                        if sk_lower(http_header_in(hdrs, "transfer-encoding")).eq("chunked") != 0
                            chunked = 1
                if hend >= 0
                    have = acc.len() - (hend + 4)
                    if clen >= 0
                        if have >= clen
                            go = 0
                    if chunked != 0
                        if sk_ends_with(acc, "0\r\n\r\n") != 0
                            go = 0
                if acc.len() > max_bytes
                    go = 0
            elsif k == 0
                go = 0
            elsif k != 0 - 11
                go = 0
    Fd.new(fd).close()
    if hend < 0
        if timed_out != 0
            return http_result(0, "", "timeout after " + timeout_ms.to_str() + " ms", "")
        return http_result(0, "", "connection closed before a complete response", "")
    head = acc.slice(0, hend)
    first_nl = sk_index_of(head, "\r\n")
    status_line = head.slice(0, head.len())
    headers = ""
    if first_nl >= 0
        status_line = head.slice(0, first_nl)
        headers = head.slice(first_nl + 2, head.len())
    sp = sk_index_of(status_line, " ")
    status = 0
    if sp >= 0
        status = sk_parse_int(status_line.slice(sp + 1, status_line.len()))
    payload = acc.slice(hend + 4, acc.len())
    if chunked != 0
        payload = http_dechunk(payload)
    elsif clen >= 0
        if payload.len() > clen
            payload = payload.slice(0, clen)
    err = ""
    if timed_out != 0
        err = "timeout after " + timeout_ms.to_str() + " ms"
    http_result(status, payload, err, headers)

fn http_get(host: String, port: Int, path: String, extra_headers: String, timeout_ms: Int) -> HttpResult ! io, alloc
    http_request("GET", host, port, path, extra_headers, "", timeout_ms, 33554432)

# POST con cuerpo JSON y token Bearer opcional (token "" = sin Authorization).
fn http_post_json(host: String, port: Int, path: String, token: String, body: String, timeout_ms: Int) -> HttpResult ! io, alloc
    h = "Content-Type: application/json"
    if token.len() > 0
        h = h + "\r\nAuthorization: Bearer " + token
    http_request("POST", host, port, path, h, body, timeout_ms, 33554432)

# ------------------------------------------------------------------ respuestas en streaming
#
# hs_open abre la conexión, envía la petición y lee las cabeceras; el cuerpo se consume por líneas
# con hs_next_line (cuerpo chunked o hasta el cierre, p. ej. text/event-stream). El plazo
# `timeout_ms` es de inactividad: se renueva con cada dato recibido.
# Asa (vec): 0 fd, 1 estado, 2 error, 3 cuerpo decodificado, 4 posición de lectura en él,
# 5 chunked, 6 bytes crudos pendientes, 7 posición en ellos, 8 fin de datos, 9 inactividad (ms),
# 10 cabeceras crudas.

fn hs_status(h: Int) -> Int
    vec_get(h, 1)

fn hs_error(h: Int) -> String
    str_from_int(vec_get(h, 2))

fn hs_headers(h: Int) -> String
    str_from_int(vec_get(h, 10))

fn hs_new(fd: Int, status: Int, err: String, idle: Int) -> Int ! alloc
    h = vec_new()
    x = vec_push(h, fd)
    x = vec_push(h, status)
    x = vec_push(h, err.to_int())
    x = vec_push(h, "".to_int())
    x = vec_push(h, 0)
    x = vec_push(h, 0)
    x = vec_push(h, "".to_int())
    x = vec_push(h, 0)
    x = vec_push(h, 0)
    x = vec_push(h, idle)
    x = vec_push(h, "".to_int())
    h

# Decodifica los chunks completos que haya en el búfer crudo y los añade al cuerpo.
fn hs_decode(h: Int) -> Int ! alloc
    raw = str_from_int(vec_get(h, 6))
    rp = vec_get(h, 7)
    dec = str_from_int(vec_get(h, 3))
    n = raw.len()
    go = 1
    while go != 0
        e = sk_index_from(raw, "\r\n", rp)
        if e < 0
            go = 0
        else
            size = sk_parse_hex(raw.slice(rp, e))
            if size <= 0
                x = vec_set(h, 8, 1)
                go = 0
            elsif e + 2 + size + 2 > n
                go = 0
            else
                dec = dec + raw.slice(e + 2, e + 2 + size)
                rp = e + 2 + size + 2
    x = vec_set(h, 3, dec.to_int())
    vec_set(h, 7, rp)

# Lee más datos del socket (espera hasta 200 ms). Devuelve 0 si ya no hay más.
fn hs_pump(h: Int) -> Int ! io, alloc
    if vec_get(h, 8) != 0
        return 0
    fd = vec_get(h, 0)
    chunk = Bytes.new(65536)
    waited = 0
    while waited < vec_get(h, 9)
        k = Fd.new(fd).read_timeout(chunk.ptr(), 65536, 200)
        if k > 0
            piece = bytes_view(chunk, 0, k).to_str()
            if vec_get(h, 5) != 0
                x = vec_set(h, 6, (str_from_int(vec_get(h, 6)) + piece).to_int())
                y = hs_decode(h)
            else
                x = vec_set(h, 3, (str_from_int(vec_get(h, 3)) + piece).to_int())
            return 1
        elsif k == 0
            x = vec_set(h, 8, 1)
            return 0
        elsif k != 0 - 11
            x = vec_set(h, 8, 1)
            return 0
        waited = waited + 200
    x = vec_set(h, 2, ("timeout: no data for " + vec_get(h, 9).to_str() + " ms").to_int())
    x = vec_set(h, 8, 1)
    0

# Abre una petición POST JSON y lee las cabeceras. hs_status es 0 si falló (ver hs_error).
fn hs_open(host: String, port: Int, path: String, token: String, body: String, timeout_ms: Int) -> Int ! io, alloc
    fd = http_connect(host, port, 5000)
    if fd < 0
        return hs_new(0 - 1, 0, "connect failed to " + host + ":" + port.to_str(), timeout_ms)
    req = "POST " + path + " HTTP/1.1\r\nHost: " + host + ":" + port.to_str() + "\r\nConnection: close\r\nAccept: text/event-stream\r\nContent-Type: application/json\r\n"
    if token.len() > 0
        req = req + "Authorization: Bearer " + token + "\r\n"
    req = req + "Content-Length: " + body.len().to_str() + "\r\n\r\n" + body
    if http_send_all(fd, req) != 0
        Fd.new(fd).close()
        return hs_new(0 - 1, 0, "send failed", timeout_ms)
    h = hs_new(fd, 0, "", timeout_ms)
    acc = ""
    hend = 0 - 1
    chunk = Bytes.new(65536)
    waited = 0
    while hend < 0
        if waited >= timeout_ms
            x = vec_set(h, 2, "timeout waiting for response headers".to_int())
            hend = 0 - 2
        else
            k = Fd.new(fd).read_timeout(chunk.ptr(), 65536, 200)
            if k > 0
                acc = acc + bytes_view(chunk, 0, k).to_str()
                hend = sk_index_of(acc, "\r\n\r\n")
            elsif k == 0
                x = vec_set(h, 2, "connection closed before response headers".to_int())
                hend = 0 - 2
            elsif k != 0 - 11
                x = vec_set(h, 2, "read error".to_int())
                hend = 0 - 2
            else
                waited = waited + 200
    if hend < 0
        x = vec_set(h, 8, 1)
        return h
    head = acc.slice(0, hend)
    first_nl = sk_index_of(head, "\r\n")
    status_line = head.slice(0, head.len())
    headers = ""
    if first_nl >= 0
        status_line = head.slice(0, first_nl)
        headers = head.slice(first_nl + 2, head.len())
    sp = sk_index_of(status_line, " ")
    if sp >= 0
        x = vec_set(h, 1, sk_parse_int(status_line.slice(sp + 1, status_line.len())))
    x = vec_set(h, 10, headers.to_int())
    payload = acc.slice(hend + 4, acc.len())
    if sk_lower(http_header_in(headers, "transfer-encoding")).eq("chunked") != 0
        x = vec_set(h, 5, 1)
        x = vec_set(h, 6, payload.to_int())
        y = hs_decode(h)
    else
        x = vec_set(h, 3, payload.to_int())
    h

# Siguiente línea del cuerpo sin el salto; char 4 si se acabaron los datos.
fn hs_next_line(h: Int) -> String ! io, alloc
    result = ""
    done = 0
    while done == 0
        dec = str_from_int(vec_get(h, 3))
        pos = vec_get(h, 4)
        e = sk_index_from(dec, "\n", pos)
        if e >= 0
            ln = dec.slice(pos, e)
            if ln.len() > 0
                if ln.char(ln.len() - 1) == 13
                    ln = ln.slice(0, ln.len() - 1)
            x = vec_set(h, 4, e + 1)
            result = ln
            done = 1
        else
            more = hs_pump(h)
            if more == 0
                dec2 = str_from_int(vec_get(h, 3))
                pos2 = vec_get(h, 4)
                if pos2 < dec2.len()
                    result = dec2.slice(pos2, dec2.len())
                    x = vec_set(h, 4, dec2.len())
                else
                    result = String.from_char(4)
                done = 1
    result

# Todo lo que queda del cuerpo (para leer un error completo).
fn hs_read_rest(h: Int) -> String ! io, alloc
    more = 1
    while more != 0
        more = hs_pump(h)
    dec = str_from_int(vec_get(h, 3))
    dec.slice(vec_get(h, 4), dec.len())

fn hs_close(h: Int) -> Int ! io
    fd = vec_get(h, 0)
    if fd >= 0
        return Fd.new(fd).close()
    0
