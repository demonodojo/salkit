# salkit/fsx.sal — ficheros y directorios con comprobación de errores.
# (en soso `read_file` hace panic si el fichero no existe; aquí se comprueba antes.)

import "io/io.sal"
import "io/abi.sal"
import "io/fs.sal"
import "strbuf.sal"

fn fsx_exists(path: String) -> Int ! io, alloc
    if Path.new(path).size() >= 0
        1
    else
        0

fn fsx_is_dir(path: String) -> Int ! io, alloc
    Path.new(path).is_dir()

fn fsx_is_file(path: String) -> Int ! io, alloc
    p = Path.new(path)
    if p.size() < 0
        return 0
    if p.is_dir() != 0
        return 0
    1

# Fecha de modificación (segundos) o -1.
fn fsx_mtime(path: String) -> Int ! io, alloc
    Path.new(path).mtime()

# Número de inodo de la ruta (siguiendo enlaces) o -1.
fn fsx_ino(path: String) -> Int ! io, alloc
    st = Bytes.new(stat_size())
    b = path_to_buf(path)
    rc = stat_path_ptr(b.ptr(), path.len(), st.ptr(), stat_size())
    if rc < 0
        return 0 - 1
    st.get_i64(stat_off_ino())

# Tamaño en bytes o -1.
fn fsx_size(path: String) -> Int ! io, alloc
    Path.new(path).size()

# Lee hasta `max` bytes. Fichero ausente, directorio o error -> Bytes vacío.
fn fsx_read_bytes_max(path: String, max: Int) -> Bytes ! io, alloc
    p = Path.new(path)
    size = p.size()
    if size <= 0
        return Bytes.new(0)
    if size > max
        size = max
    fd = p.open_read()
    if fd < 0
        return Bytes.new(0)
    buf = Bytes.new(size)
    pos = 0
    go = 1
    while go != 0
        if pos >= size
            go = 0
        else
            k = Fd.new(fd).read(buf.ptr() + pos, size - pos)
            if k <= 0
                go = 0
            else
                pos = pos + k
    Fd.new(fd).close()
    bytes_view(buf, 0, pos)

fn fsx_read_bytes(path: String) -> Bytes ! io, alloc
    fsx_read_bytes_max(path, 268435456)

fn fsx_read_text_max(path: String, max: Int) -> String ! io, alloc
    b = fsx_read_bytes_max(path, max)
    n = b.len()
    if n <= 0
        return ""
    b.to_str()

fn fsx_read_text(path: String) -> String ! io, alloc
    fsx_read_text_max(path, 268435456)

# Escribe todo `data` en `fd` (varios write si hace falta). 0 si ok, 1 si error.
fn fsx_write_fd(fd: Int, data: String) -> Int ! io, alloc
    n = data.len()
    if n <= 0
        return 0
    buf = Bytes.new(n)
    buf.write_str(0, data)
    pos = 0
    while pos < n
        k = Fd.new(fd).write(buf.ptr() + pos, n - pos)
        if k <= 0
            return 1
        pos = pos + k
    0

fn fsx_open_write(path: String, flags: Int) -> Int ! io, alloc
    parent = Path.new(path.slice(0, path.len())).parent()
    if parent.len() > 0
        Path.new(parent).mkdir_p()
    b = path_to_buf(path)
    open_flags(b.ptr(), path.len(), flags)

# Crea los directorios que falten y sobrescribe el fichero. 0 si ok.
fn fsx_write(path: String, data: String) -> Int ! io, alloc
    fd = fsx_open_write(path, o_WRONLY() + o_CREAT() + o_TRUNC())
    if fd < 0
        return 1
    r = fsx_write_fd(fd, data)
    Fd.new(fd).close()
    r

fn fsx_append(path: String, data: String) -> Int ! io, alloc
    fd = fsx_open_write(path, o_WRONLY() + o_CREAT() + o_APPEND())
    if fd < 0
        return 1
    r = fsx_write_fd(fd, data)
    Fd.new(fd).close()
    r

fn fsx_remove(path: String) -> Int ! io, alloc
    b = path_to_buf(path)
    unlink_path_ptr(b.ptr(), path.len())

# Entradas de un directorio ordenadas; los subdirectorios llevan "/" final (el shim de Linux
# cuenta como directorio un enlace simbólico que apunta a uno).
fn fsx_list_dir(dir: String) -> Int ! io, alloc
    sl = vec_new()
    fd = Path.new(dir).open_read()
    if fd < 0
        return sl
    buf = Bytes.new(dirent_size())
    go = 1
    while go != 0
        got = getdents_fd(fd, buf.ptr(), dirent_size())
        if got <= 0
            go = 0
        else
            nl = buf.get_u8(dirent_off_name_len())
            if nl > 0
                name = bytes_view(buf, dirent_off_name(), nl).to_str()
                dot = 0
                if name.eq(".") != 0
                    dot = 1
                if name.eq("..") != 0
                    dot = 1
                if dot == 0
                    if buf.get_u8(dirent_off_file_type()) == ft_dir()
                        name = name + "/"
                    x = vec_push(sl, name.to_int())
    x = Fd.new(fd).close()
    x = sk_sl_sort(sl)
    sl

# Rutas de fichero bajo `root`, relativas a él y ordenadas. `ignores` es una lista de
# nombres base (ficheros o directorios) que se saltan. Para en `max` resultados.
fn fsx_walk(root: String, ignores: Int, max: Int) -> Int ! io, alloc
    out = vec_new()
    x = fsx_walk_into(out, root, "", ignores, max, 0, ",")
    x = sk_sl_sort(out)
    out

# `anc` lleva los inodos de los directorios ascendientes (",12,40,"): un enlace que apunta a uno
# de ellos se salta para no girar en bucle.
fn fsx_walk_into(out: Int, root: String, rel: String, ignores: Int, max: Int, depth: Int, anc: String) -> Int ! io, alloc
    if depth > 40
        return 0
    dir = root.slice(0, root.len())
    if rel.len() > 0
        dir = root + "/" + rel
    ino = fsx_ino(dir)
    if ino >= 0
        if sk_contains(anc, "," + ino.to_str() + ",") != 0
            return 0
    mine = anc + ino.to_str() + ","
    names = fsx_list_dir(dir)
    n = vec_len(names)
    i = 0
    while i < n
        if vec_len(out) >= max
            return 0
        name = sk_sl_get(names, i)
        isdir = sk_ends_with(name, "/")
        base = name.slice(0, name.len())
        if isdir != 0
            base = name.slice(0, name.len() - 1)
        if sk_sl_contains(ignores, base) == 0
            relp = base.slice(0, base.len())
            if rel.len() > 0
                relp = rel + "/" + base
            if isdir != 0
                x = fsx_walk_into(out, root, relp, ignores, max, depth + 1, mine)
            else
                x = vec_push(out, relp.to_int())
        i = i + 1
    0
