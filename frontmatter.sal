# salkit/frontmatter.sal — cabecera "---" estilo YAML sencillo (agentes y skills).
#
# Admite `clave: valor`, mapas y listas anidados por sangría, `- elemento`, valores
# entre comillas, `[a, b]`, true/false/null/números y comentarios `#`.
# El resultado se convierte a un documento de salkit/json.sal.

import "json.sal"
import "strbuf.sal"
import "int.sal"

# Resultado de `fm_parse`: documento JSON (asa de json.sal), cuerpo (texto tras la
# cabecera) y si había cabecera (1/0).
struct Frontmatter
    doc: Int
    body: String
    has_header: Int

fn fm_doc(fm: Frontmatter) -> Int
    fm.doc

fn fm_root(fm: Frontmatter) -> Int
    json_root(fm.doc)

fn fm_body(fm: Frontmatter) -> String
    fm.body

fn fm_has_header(fm: Frontmatter) -> Int
    fm.has_header

# Valor de una clave de primer nivel como texto ("" si falta).
fn fm_get(fm: Frontmatter, key: String) -> String
    d = fm.doc
    json_get_str(d, json_root(d), key)

fn fm_has(fm: Frontmatter, key: String) -> Int
    d = fm.doc
    json_has(d, json_root(d), key)

fn fm_indent(line: String) -> Int
    n = line.len()
    i = 0
    while i < n
        if line.char(i) == 32
            i = i + 1
        else
            return i
    i

# 1 si la línea está vacía o es un comentario.
fn fm_blank(line: String) -> Int ! alloc
    t = sk_trim(line)
    if t.len() == 0
        return 1
    if t.char(0) == 35
        return 1
    0

# Quita un comentario final " # ..." de un valor sin comillas.
fn fm_strip_comment(s: String) -> String ! alloc
    if s.len() > 0
        if s.char(0) == 34
            return s
        if s.char(0) == 39
            return s
    i = sk_index_of(s, " #")
    if i >= 0
        return sk_trim(s.slice(0, i))
    s

fn fm_unquote(s: String) -> String ! alloc
    n = s.len()
    if n >= 2
        a = s.char(0)
        b = s.char(n - 1)
        if a == 34
            if b == 34
                return s.slice(1, n - 1)
        if a == 39
            if b == 39
                return s.slice(1, n - 1)
    s

# Escalar -> fragmento JSON.
fn fm_scalar(raw: String) -> String ! alloc
    s = sk_trim(fm_strip_comment(sk_trim(raw)))
    n = s.len()
    if n == 0
        return "\"\""
    if s.char(0) == 34
        return json_quote(fm_unquote(s))
    if s.char(0) == 39
        return json_quote(fm_unquote(s))
    if s.eq("true") != 0
        return "true"
    if s.eq("false") != 0
        return "false"
    if s.eq("null") != 0
        return "null"
    if s.eq("~") != 0
        return "null"
    if sk_is_int(s) != 0
        return s
    if s.char(0) == 91
        if s.char(n - 1) == 93
            return fm_inline_list(s.slice(1, n - 1))
    json_quote(s)

fn fm_inline_list(inner: String) -> String ! alloc
    if sk_trim(inner).len() == 0
        return String.from_char(91) + String.from_char(93)
    parts = sk_split_char(inner, 44)
    items = sk_sl_new()
    n = sk_sl_len(parts)
    i = 0
    while i < n
        sk_sl_push(items, fm_scalar(sk_sl_get(parts, i)))
        i = i + 1
    jb_arr(jb_join(items))

# Índice de la primera línea con contenido en [i, end), o end.
fn fm_next_content(lines: Int, i: Int, end: Int) -> Int ! alloc
    j = i
    while j < end
        if fm_blank(sk_sl_get(lines, j)) == 0
            return j
        j = j + 1
    end

# Posición del ":" que separa clave y valor (ignora los ":" dentro de comillas), o -1.
fn fm_colon(line: String) -> Int
    n = line.len()
    i = 0
    q = 0
    while i < n
        c = line.char(i)
        if q == 0
            mark = match c
                34 => 34
                39 => 39
                58 => 58
                _ => 0
            if mark == 58
                if i + 1 >= n
                    return i
                if line.char(i + 1) == 32
                    return i
            elsif mark != 0
                q = mark

        elsif c == q
            q = 0
        i = i + 1
    0 - 1

# 1 si `rest` abre un bloque literal (| |- |+), 2 si abre uno plegado (> >- >+); 0 si no.
fn fm_block_style(rest: String) -> Int ! alloc
    n = rest.len()
    if n == 0
        return 0
    c = rest.char(0)
    style = match c
        124 => 1
        62 => 2
        _ => 0
    if style == 0
        return 0
    i = 1
    while i < n
        d = rest.char(i)
        ok = 0
        if d == 45
            ok = 1
        elsif d == 43
            ok = 1
        elsif d >= 48
            if d <= 57
                ok = 1
        if ok == 0
            return 0
        i = i + 1
    style

# Cuerpo de un bloque literal/plegado que empieza en la línea `start` y cuyas líneas tienen
# más sangría que `ind`. Avanza cur[0] tras el bloque y devuelve el escalar JSON.
fn fm_block(lines: Int, end: Int, ind: Int, start: Int, cur: Int, style: Int) -> String ! alloc
    stop = start
    base = 0 - 1
    go = 1
    while go != 0
        if stop >= end
            go = 0
        else
            ln = sk_sl_get(lines, stop)
            if sk_trim(ln).len() == 0
                stop = stop + 1
            elsif fm_indent(ln) > ind
                if base < 0
                    base = fm_indent(ln)
                stop = stop + 1
            else
                go = 0
    fm_block_emit(lines, start, fm_last_content(lines, start, stop), base, cur, stop, style)

# Fin (exclusivo) del bloque sin las líneas en blanco finales.
fn fm_last_content(lines: Int, start: Int, stop: Int) -> Int ! alloc
    last = stop
    while last > start
        if sk_trim(sk_sl_get(lines, last - 1)).len() == 0
            last = last - 1
        else
            return last
    last

fn fm_block_emit(lines: Int, start: Int, last: Int, base: Int, cur: Int, stop: Int, style: Int) -> String ! alloc
    vec_set(cur, 0, stop)
    paras = sk_sl_new()
    cur_para = sk_sl_new()
    i = start
    while i < last
        ln = sk_sl_get(lines, i)
        text = ""
        if sk_trim(ln).len() > 0
            cut = base
            if cut > ln.len()
                cut = ln.len()
            text = ln.slice(cut, ln.len())
        if style == 1
            y = sk_sl_push(paras, text)
        elsif text.len() == 0
            y = sk_sl_push(paras, sk_join(cur_para, " "))
            cur_para = sk_sl_new()
        else
            z = sk_sl_push(cur_para, sk_trim(text))
        i = i + 1
    if style == 2
        w = sk_sl_push(paras, sk_join(cur_para, " "))
    json_quote(sk_trim(sk_join(paras, String.from_char(10))))

# Mapa por sangría; cur[0] es la línea actual y avanza.
fn fm_map(lines: Int, end: Int, indent: Int, cur: Int) -> String ! alloc
    parts = sk_sl_new()
    go = 1
    while go != 0
        i = fm_next_content(lines, vec_get(cur, 0), end)
        if i >= end
            go = 0
        else
            line = sk_sl_get(lines, i)
            ind = fm_indent(line)
            if ind < indent
                go = 0
            else
                text = sk_trim(line)
                c = fm_colon(text)
                if c <= 0
                    r1 = vec_set(cur, 0, i + 1)
                else
                    key = fm_unquote(sk_trim(text.slice(0, c)))
                    rest = sk_trim(fm_strip_comment(sk_trim(text.slice(c + 1, text.len()))))
                    vec_set(cur, 0, i + 1)
                    val = ""
                    bstyle = fm_block_style(rest)
                    if bstyle != 0
                        val = fm_block(lines, end, ind, i + 1, cur, bstyle)
                    elsif rest.len() > 0
                        val = fm_scalar(rest)
                    else
                        nx = fm_next_content(lines, i + 1, end)
                        val = "null"
                        if nx < end
                            nind = fm_indent(sk_sl_get(lines, nx))
                            if nind > ind
                                if sk_starts_with(sk_trim(sk_sl_get(lines, nx)), "-") != 0
                                    val = fm_list(lines, end, nind, cur)
                                else
                                    val = fm_map(lines, end, nind, cur)
                    r3 = sk_sl_push(parts, jb_kv(key, val))
    jb_obj(jb_join(parts))

fn fm_list(lines: Int, end: Int, indent: Int, cur: Int) -> String ! alloc
    parts = sk_sl_new()
    go = 1
    while go != 0
        i = fm_next_content(lines, vec_get(cur, 0), end)
        if i >= end
            go = 0
        else
            line = sk_sl_get(lines, i)
            text = sk_trim(line)
            if fm_indent(line) < indent
                go = 0
            elsif sk_starts_with(text, "-") == 0
                go = 0
            else
                vec_set(cur, 0, i + 1)
                item = sk_trim(text.slice(1, text.len()))
                r2 = sk_sl_push(parts, fm_scalar(item))
    jb_arr(jb_join(parts))

fn fm_result(json_text: String, body: String, has: Int) -> Frontmatter ! alloc
    Frontmatter(json_parse(json_text), body, has)

# Separa y convierte la cabecera de un texto. Sin cabecera, el documento es {} y
# el cuerpo es todo el texto.
fn fm_parse(text: String) -> Frontmatter ! alloc
    lines = sk_split_lines(text)
    n = sk_sl_len(lines)
    empty = jb_obj("")
    if n == 0
        return fm_result(empty, text, 0)
    if sk_trim(sk_sl_get(lines, 0)).eq("---") == 0
        return fm_result(empty, text, 0)
    close = 0 - 1
    i = 1
    while i < n
        if close < 0
            if sk_trim(sk_sl_get(lines, i)).eq("---") != 0
                close = i
        i = i + 1
    if close < 0
        return fm_result(empty, text, 0)
    cur = vec_new()
    vec_push(cur, 1)
    js = fm_map(lines, close, 0, cur)
    body_lines = sk_sl_new()
    j = close + 1
    while j < n
        sk_sl_push(body_lines, sk_sl_get(lines, j))
        j = j + 1
    body = sk_join(body_lines, String.from_char(10))
    fm_result(js, body, 1)
